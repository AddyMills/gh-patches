loading_tip_1 = "In caso di difficoltà, accedi alle lezioni contenute nel menu Esercizi."
loading_tip_10 = "Non pensare che la tua band sia la prima a salire sul palco con tutti i componenti vestiti di nero."
loading_tip_11 = "Sì, le casse spia sul palco sono in effetti dei trampolini."
loading_tip_12 = "Non lasciare mai al cantante la responsabilità del mix."
loading_tip_13 = "Può essere sempre più forte."
loading_tip_14 = "Siamo un gruppo di gente arrabbiata, ma ciò non significa che non crediamo nella pace."
loading_tip_15 = "20 minuti di odissea nel free jazz non vanno bene."
loading_tip_16 = "La gente non è disposta a sborsare quattrini per sentirti improvvisare."
loading_tip_17 = "Ci vuole molto tempo prima di potersi minimamente paragonare a te."
loading_tip_18 = "Accertati che qualcuno nel gruppo sappia come sostituire una gomma bucata."
loading_tip_19 = "Alza quel volume! Le mie orecchie non stanno neanche sanguinando!"
loading_tip_2 = "Vai all'emporio per comprare nuove canzoni, vestiti eccezionali e stili straordinari."
loading_tip_20 = "Impazzivo di rabbia quando il mio amplificatore prendeva fuoco. Adesso invece devo dire che mi piace parecchio!"
loading_tip_21 = "Le chitarre distrutte sembrano suonare meglio delle loro sorelle intatte!"
loading_tip_22 = "Hai suonato esattamente come la volta scorsa... ossia una vera schifezza!"
loading_tip_23 = "Sei un fenomeno. Sono sicuro che i fischi erano solo per il tuo vestito!"
loading_tip_24 = "Al momento giusto forse comparirà una drum machine che ti consentirà di esercitarti un po'."
loading_tip_25 = "Secondo me, hai dei problemi con l'amplificazione del basso. Lo sento da qui!"
loading_tip_26 = "Vai là fuori, scatenati come sai e vendi un po' di magliette, così almeno possiamo mangiare."
loading_tip_27 = "Iniziamo con il nostro ultimo single.  Così ce lo leviamo subito dalle *&?#@!"
loading_tip_28 = "Sono il batterista.  Non vengo pagato per capire questa roba!"
loading_tip_29 = "Glielo giuro, agente, la TV del camerino si è svitata da sola dal muro ed è volata dalla finestra!"
loading_tip_3 = "Vuoi rockeggiare con un amico?  Crea un nuovo gruppo nella carriera cooperativa."
loading_tip_30 = "Giocare da solo è noioso? Vai online e affronta avversari reali!"
loading_tip_31 = "Hai bisogno di nuove canzoni? Accedi al menu online per scoprire se sono disponibili dei nuovi brani!"
loading_tip_32 = "Ti serve un amico per suonare in modalità cooperativa? Vai online! Ci sono molte persone con cui fare amicizia e suonare assieme!"
loading_tip_4 = "Se ti eserciti un po' potrai dominare quegli assolo così complicati."
loading_tip_5 = "Se non hai mai registrato un demo, non fai parte di un vero gruppo."
loading_tip_6 = "Assicurati che il pubblico sia pronto ad afferrarti prima di lanciarti dal palco!"
loading_tip_7 = "MAI utilizzare fuochi d'artificio fatti in casa."
loading_tip_8 = "Per tradizione, si arriva sempre in ritardo di 30 minuti alle prove."
loading_tip_9 = "Possiamo diminuire il riverbero delle casse spia?"
