loading_tip_1 = "¿Algún problema? Consulta los tutoriales del menú de ensayo."
loading_tip_2 = "Echa un vistazo a las canciones nuevas y a los vestuarios y estilos que más molan."
loading_tip_3 = "¿Quieres dar caña con un amigo?  Inicia un grupo nuevo en Carrera cooperativa."
loading_tip_4 = "Practicar te puede ayudar a clavar esos solos difíciles."
loading_tip_5 = "Si no habéis grabado en un 4 pistas, no sois un grupo de verdad."
loading_tip_6 = "Asegúrate de que la peña quiere cogerte antes de tirarte desde el escenario."
loading_tip_7 = "NO utilices pirotecnia casera."
loading_tip_8 = "Llegar media hora tarde al ensayo forma parte de la tradición."
loading_tip_9 = "¿Puedo sacar algo más de partido de los monitores?"
loading_tip_10 = "¿Acaso os pensábais que erais el primer grupo que subía al escenario vestido completamente de negro?"
loading_tip_11 = "Sí, los monitores de escenario en realidad son trampolines."
loading_tip_12 = "Nunca más dejes al cantante encargado de la mezcla."
loading_tip_13 = "Nunca suena demasiado potente."
loading_tip_14 = "Somos un grupo muy duro, pero eso no significa que no creamos en la paz."
loading_tip_15 = "Los conciertos de jazz improvisados que duran 20 minutos no molan."
loading_tip_16 = "La gente pasa tres kilos de pagar dinero por escucharte improvisar."
loading_tip_17 = "¡Cuántas molestias para tener la misma pinta que todos traemos al despertarnos!"
loading_tip_18 = "Procura que alguien del grupo sepa cómo cambiar una rueda pinchada."
loading_tip_19 = "Sube el volumen de ese ampli, que aún no me he quedado sordo."
loading_tip_20 = "Siempre me ponía a temblar cuando mi ampli se quemaba.  Ahora ya me da igual."
loading_tip_21 = "Parece que las guitarras espachurradas suenan mejor que sus hermanas no espachurradas."
loading_tip_22 = "Eres exactamente como tu último concierto... Un fracaso."
loading_tip_23 = "Lo hiciste muy bien.  Seguro que están abucheándote por tu vestuario."
loading_tip_24 = "A lo mejor un batería llega a tiempo al ensayo."
loading_tip_25 = "Parece que tienes problemas con el ampli de tu bajo. ¡Puedo oírlo!"
loading_tip_26 = "Sal ahí fuera, mete caña y vende muchas camisetas. Así tendremos algo que comer."
loading_tip_27 = "Empecemos con nuestro último single.  ¡Así podemos sacarnos a ese *&?#@! del medio enseguida!"
loading_tip_28 = "Yo soy el batería,  ¡a mí no me pagan para entender nada de esto!"
loading_tip_29 = "¡Se lo juro, agente, el televisor del camerino se ha descolgado solo y se ha tirado por la ventana!"
loading_tip_30 = " ¿El solo se está convirtiendo en algo del pasado? ¡Entra online y compite en directo!"
loading_tip_31 = "¿Te hacen falta canciones nuevas? ¡Consulta el menú en línea para ver si hay canciones nuevas disponibles!"
loading_tip_32 = "¿Quieres jugar en modo Cooperativo pero no tienes ningún amigo a mano? ¡Juega en línea e improvisa!"
