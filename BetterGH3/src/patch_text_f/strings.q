loading_tip_1 = "Des difficultés ? Va voir les didacticiels dans le menu Entraînement."
loading_tip_10 = "Plein d'autres groupes s'habillaient déjà tout en noir avant ta naissance."
loading_tip_11 = "Oui, oui, les enceintes sur scène servent en fait de plongeoirs."
loading_tip_12 = "Ne jamais, JAMAIS, laisser le chanteur s'occuper du mixage."
loading_tip_13 = "Tu peux toujours jouer plus fort."
loading_tip_14 = "Ce n'est pas parce qu'on est agressifs qu'on n'aime pas la paix."
loading_tip_15 = "20 minutes d'impro de free jazz, très peu pour moi."
loading_tip_16 = "Personne n'a envie de payer pour t'entendre jouer."
loading_tip_17 = "Faut pas croire, un look négligé, ça se travaille."
loading_tip_18 = "Un groupe sans un bon mécano, c'est la cata assurée."
loading_tip_19 = "Augmente le volume de l'ampli. C'est à peine si mes oreilles entendent quelque chose."
loading_tip_2 = "Va voir dans le Magasin les nouvelles chansons et tenues et styles vraiment cool."
loading_tip_20 = "Avant, je m'affolais quand mon ampli prenait feu. Maintenant ça ne me fait plus rien."
loading_tip_21 = "Il semblerait que les guitares fracassées aient une meilleure acoustique que leurs consoeurs intactes."
loading_tip_22 = "Tu es aussi bon que ton dernier concert... qui craignait un max."
loading_tip_23 = "Tu as super bien joué. Je suis sûr que les sifflets, c'était juste pour tes fringues."
loading_tip_24 = "Une boîte à rythmes se pointerait peut-être à l'heure aux répètes."
loading_tip_25 = "On dirait que t'as un problème avec l'ampli de ta basse. Je l'entends !"
loading_tip_26 = "Va jouer sur scène et vends quelques t-shirts pour qu'on puisse manger ce soir."
loading_tip_27 = "Allez, on commence avec le dernier single.  Comme ça on en aura fini avec cette *&?#@ !"
loading_tip_28 = "Je ne suis que le batteur. On ne me paie pas pour connaître ces trucs !"
loading_tip_29 = "Je le jure, m'sieur l'agent, la télé de la loge s'est débranchée toute seule et elle s'est jetée par la fenêtre !"
loading_tip_3 = "Tu veux faire la star avec un ami ?  Forme ton groupe en mode Coop."
loading_tip_30 = "Marre de jouer en solo ? Connecte-toi et affronte la compétition en live !"
loading_tip_31 = "Besoin de nouvelles\\nchansons ? Jette un oeil sur le menu en ligne pour voir si du nouveau contenu est disponible !"
loading_tip_32 = "Tu veux jouer en mode Coop mais tu n'as pas d'amis ? Va en ligne te trouver un partenaire de rock !"
loading_tip_4 = "Un peu d'entraînement devrait t'aider à maîtriser ces solos pas faciles."
loading_tip_5 = "Si tu n'as jamais enregistré sur un 4 pistes, ton groupe est bidon."
loading_tip_6 = "Assure-toi que le public va te rattraper avant de sauter dans la fosse."
loading_tip_7 = "Les feux d'artifice faits maison sont INTERDITS."
loading_tip_8 = "Arriver en retard aux répètes, c'est une tradition."
loading_tip_9 = "On peut avoir un meilleur retour son ?"
