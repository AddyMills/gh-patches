		type = guitar
		guitar = special
		finish = "Special"
		blurb = "Une sorte d'OVNI devenu un instrument de musique suite à un bouleversement de l'espace-temps dans la septième dimension.\\n\\n Déchaîne-toi avec ce petit bijou venue d'une autre galaxie aux tonalités sauvages et groovy.\\n\\n On se calme !"
	}
	{
		name = "'59 Les Paul"
		name2 = "de Slash"
		logo = "Gibson"
		desc_id = Instrument_Guitar_Slash01
		desc_name = 'Instrument_Guitar_Slash01'
		mesh = 'models\\Guitars\\Guitar_Skin_Slash.skin'
		pak = 'pak\\models\\guitars\\Slash01\\Slash01.pak'
		type = guitar
		guitar = special
		finish = "Special"
		blurb = "Il s'agit de la guitare de prédilection de Slash lors des enregistrements en studio.\\n\\nOn peut l'entendre sur les albums vendus à des millions d'exemplaires des Guns 'n' Roses, notamment 'Appetite for Destruction' et 'Lies'.\\n\\nCette guitare est le 'Saint Graal' de Slash. Elle repose dans un coffre-fort quand il ne s'en sert pas. "
	}
	{
