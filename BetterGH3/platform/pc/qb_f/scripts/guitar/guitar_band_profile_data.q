	{
		name = " SG "
		name2 = "Standard"
		logo = "Epiphone"
		desc_id = Instrument_EpiSG01
		desc_name = 'Instrument_EpiSG01'
		mesh = 'models\\Guitars\\Guitar_Skin_EpiSG01.skin'
		pak = 'pak\\models\\guitars\\Epiphone\\EpiSG01.pak'
		type = guitar
		guitar = epiphone_SG
		finish = "Red"
		blurb = "Epiphone est la marque d'entrée de gamme de Gibson. Cette société fabrique des répliques de la SG destinées à ceux qui n'ont pas les moyens de s'acheter une SG originale.\\n\\nDepuis 1961, la SG est l'alternative de prédilection à la Les Paul des fans de Gibson. Plus fine et plus légère que la Les Paul, elle offre une sonorité différente et une expérience de jeu comparable à celle de sa grande soeur.\\n\\nLes styles, options et finitions de la SG, autre Gibson classique, sont personnalisables.\\n\\nDes artistes de renom ont contribué au succès de la SG, tels que Jimi Hendrix, Angus Young et Pete Townshend.\\n\\nLa SG était la guitare préférée d'Eric Clapton quand il faisait partie des Cream."
	}
