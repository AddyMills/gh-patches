	{
		name = "Corvus"
		name2 = "II"
		logo = "Gibson"
		desc_id = Instrument_Corvus_NATO
		desc_name = 'Instrument_Corvus_NATO'
		mesh = 'models\\Guitars\\Guitar_skin_Corvus_NATO.skin'
		pak = 'pak\\models\\guitars\\Corvus_NATO\\Corvus_NATO.pak'
		type = guitar
		guitar = corvus
		finish = "Natural"
		blurb = "Avec la Corvus, Gibson a cherché à présenter un nouveau modèle au public.\\n\\nLa plupart des guitaristes ont dû trouver sa silhouette atypique trop radicale comparé aux milliers d'autres guitares sur le marché, ou alors, encore une fois, Gibson était en avance sur son temps. \\n\\nQuelle que soit la raison, cette guitare a été à l'époque un échec commercial, mais comme pour la Marauder, elle est à présent un objet de collection en raison de sa rareté et son aspect inhabituel.\\n\\nSi tu aimes sortir du lot, c'est ce qu'il te faut."
	}
