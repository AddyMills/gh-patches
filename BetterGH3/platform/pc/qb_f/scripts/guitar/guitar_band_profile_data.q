musician_instrument = [
	{
		name = "ES335"
		name2 = "Dot"
		logo = "Gibson"
		desc_id = Instrument_ES335_Red
		desc_name = 'Instrument_ES335_Red'
		mesh = 'models\\Guitars\\Guitar_Skin_ES335_Red.skin'
		pak = 'pak\\models\\guitars\\ES335_Red\\ES335_Red.pak'
		type = guitar
		guitar = es335
		finish = "Cherry"
		blurb = "La ES-335 est une guitare électrique à table bombée et à caisse creuse, modèle pratiquement inchangé depuis 1958.\\n\\nElle est le résultat des essais pour mettre au point 'la Bûche', une Les Paul électrique amplifée.\\n\\nLes expérimentations de Les Paul ont également donné naissance à la guitare à caisse pleine.\\n\\nLa ES-335 est une guitare compacte et ergonomique dotée d'une sonorité étonnante.\\n\\nElle a appartenu, entre autres, à Alex Lifeson, B.B. King et Dave Grohl."
	}
	{
		name = "ES335"
