	{
		name = "SG"
		name2 = "Special Faded"
		logo = "Gibson"
		desc_id = Instrument_SG_Worn_Brown
		desc_name = 'Instrument_SG_Worn_Brown'
		mesh = 'models\\Guitars\\Guitar_Skin_SG001.skin'
		pak = 'pak\\models\\guitars\\SG_WornBrown\\SG_WornBrown.pak'
		type = guitar
		guitar = sg
		finish = "Worn Brown"
		blurb = "Depuis 1961, la SG est l'alternative de prédilection à la Les Paul des fans de Gibson.\\n\\nPlus fine et plus légère que la Les Paul, elle offre une sonorité différente et une expérience de jeu comparable à celle de sa grande soeur.\\n\\nLes styles, options et finitions de la SG, autre Gibson classique, sont personnalisables.\\n\\nDes artistes de renom ont contribué au succès de la SG, tels que Jimi Hendrix, Angus Young et Pete Townshend. La SG était la guitare préférée d'Eric Clapton quand il faisait partie des Cream."
	}
	{
		name = "SG"
		name2 = "Special Faded"
		logo = "Gibson"
