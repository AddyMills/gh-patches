	{
		name = " Explorer "
		name2 = "Standard"
		logo = "Epiphone"
		desc_id = Instrument_EpiExplor01
		desc_name = 'Instrument_EpiExplor01'
		mesh = 'models\\Guitars\\Guitar_Skin_EpiExplor01.skin'
		pak = 'pak\\models\\guitars\\Epiphone\\EpiExplor01.pak'
		type = guitar
		guitar = epiphone_Explorer
		finish = "Red"
		blurb = "Epiphone est la marque d'entrée de gamme de Gibson. Cette société fabrique des répliques de l'Explorer destinées à ceux qui n'ont pas les moyens de s'acheter une Explorer originale.\\n\\n Les premiers modèles Gibson Explorer datent de 1958. Elle prit par la suite le nom de Futura. Cette guitare se démarquait par sa forme radicale et futuriste, un peu comme sa cousine, la Flying V.\\n\\nElle eut très peu de succès à ses débuts et sa production fut stoppée en 1959.\\n\\nEn 1975, Gibson reprit la production et les ventes explosèrent, prouvant que certaines idées sont parfois en avance sur leur époque.\\n\\nThe Edge, James Hetfield et Dave Grohl ont contribué à la popularité de cet instrument dynamique."
	}
	{
		name = " Explorer "
