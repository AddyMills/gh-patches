		pak = 'pak\\models\\guitars\\Fortune\\Fortune.pak'
		type = guitar
		guitar = special
		finish = "Fortune"
		blurb = "Toujours plus de folie TIKI : collectionne l'ensemble complet et remporte un fantastique cadeau !\\n\\nCette guitare Tiki te rappellera l'immense océan Pacifique, la vie heureuse sur une île exotique et un amour perdu.\\n\\nC'était la vraie vie.\\n\\nTout était idyllique.\\n\\nLe soleil brillait, les journées étaient sans fin et tout était disponible en abondance.\\n\\nEt puis il a fallu que tu entres dans un groupe..."
	}
