		blurb = "Vois ceci comme une jambe de femme transformée en guitare.\\n\\nIl te faut le kit complet. Ça va te coûter les yeux de la tête."
	}
	{
		name = "El Jefe"
		name2 = "The Las Vegan"
		logo = "Special"
		desc_id = Instrument_Guitar_Pharaoh
		desc_name = 'Instrument_Guitar_Pharaoh'
		mesh = 'models\\Guitars\\Guitar_Skin_Pharaoh.skin'
		pak = 'pak\\models\\guitars\\Pharaoh\\Pharaoh.pak'
		type = guitar
		guitar = special
		finish = "Special"
		blurb = "La rumeur court que Cléopâtre en personne aurait offert cet instrument à César, comme preuve de son amour infini.\\n\\nD'autres pensent qu'il pourrait s'agir du luth sacré du pharaon Nebkheperourê Toutankhamon, fils d'Amenhotep III.\\n\\nD'autres encore supposent qu'il s'agirait de l'ancienne lyre en or offerte à la Reine Victoria par Sir Samuel Baker, célèbre explorateur du XIXème siècle.\\n\\nEn réalité, ce n'est qu'une vulgaire babiole en plastique achetée à Las Vegas."
	}
	{
		name = "Axe"
		name2 = "Clix"
		logo = "Special"
		desc_id = Instrument_Axe
		desc_name = 'Instrument_Guitar_Axe'
		mesh = 'models\\Guitars\\Guitar_Skin_Axe.skin'
		pak = 'pak\\models\\guitars\\Axe\\Axe.pak'
		type = guitar
		guitar = special
		finish = "Special"
		blurb = "De la part de ces braves gaillards de chez Axe, une gratte alliant perfection et élégance avec une table rapide et précise.\\n\\nEt avec elle, tu pourras enfin sortir des notes dignes de ce nom."
	}
	{
		name = "Distant Visitor"
		name2 = "Estimation des risques"
		logo = "Special"
