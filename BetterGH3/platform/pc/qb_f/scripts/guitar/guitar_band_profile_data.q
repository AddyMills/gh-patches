	{
		name = "DMZ6000g"
		name2 = "Aluminum Neck"
		logo = "Kramer"
		desc_id = Instrument_DMZ6000G
		desc_name = 'Instrument_DMZ6000G'
		mesh = 'models\\Guitars\\Guitar_Skin_DMZ6000g.skin'
		pak = 'pak\\models\\guitars\\DMZ6000g\\DMZ6000g.pak'
		type = guitar
		guitar = dmz6000g
		finish = "Natural"
		blurb = "Le manche en aluminium des guitares Kramer était une petite révolution en soi à l'époque.\\n\\nLa Kramer est ultrasolide et produit un son dément. Kramer a fabriqué des guitares de formes différentes à partir de bois somptueux.\\n\\nCes guitares conviennent aussi bien à la scène qu'aux enregistrements en studio."
	}
	{
		name = "Synapse"
		name2 = "SS-2FA Custom"
		logo = "Steinberger"
		desc_id = Instrument_synaps
		desc_name = 'Instrument_synaps'
		mesh = 'models\\Guitars\\Guitar_Skin_Synapse.skin'
		pak = 'pak\\models\\guitars\\synaps\\synaps.pak'
		type = guitar
		guitar = Synapse
		finish = "Black"
		blurb = "Ned Steinberger a créé la L2 dans les années 70 et en a vendu trois prototypes à John Entwistle, Tony Levin et Andy West. Fabriqués en matériau composite au carbone graphite, ils se démarquaient par une absence de tête et un chevalet en bout de caisse. Les premières basses se sont  vendues dès les années 80. Les séries M et L (conçues par Mike Rutherford) ont précédé la Synapse.\\n\\nUn corps dépouillé, pas de tête, la Synapse est la dernière génération de guitares Steinberger. Sa maniabilité, sa solidité et sa sonorité n'ont rien à envier à ses prédécesseurs. "
	}
	{
		name = "   Les Paul   "
		name2 = "Standard"
		logo = "Epiphone"
		desc_id = Instrument_EpiPaul01
		desc_name = 'Instrument_EpiPaul01'
		mesh = 'models\\Guitars\\Guitar_Skin_EpiPaul01.skin'
		pak = 'pak\\models\\guitars\\Epiphone\\EpiPaul01.pak'
		type = guitar
		guitar = epiphone_les_paul
		finish = "Black"
		blurb = "Epiphone est la marque d'entrée de gamme de Gibson. Cette société fabrique des répliques de la Les Paul destinées à ceux qui n'ont pas les moyens de s'acheter la Les Paul originale, mais qui veulent profiter des sonorités et de l'ergonomie de la plus grande guitare de tous les temps.\\n\\nTout guitariste digne de ce nom peut reconnaître une Les Paul les yeux fermés.\\n\\nIl s'agit de la guitare de prédilection de tous les Dieux du rock.\\n\\nSans Jimmy Page, Zakk Wylde, Slash et d'autres grands artistes, la Les Paul ne serait peut-être pas devenue la guitare légendaire qu'elle est aujourd'hui.\\n\\nMonte sur scène avec cette guitare et gagne ta place au panthéon du Rock !"
	}
	{
		name = "   Les Paul   "
		name2 = "Standard"
		logo = "Epiphone"
