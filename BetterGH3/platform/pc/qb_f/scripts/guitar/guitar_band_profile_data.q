	{
		name = "Marauder"
		name2 = "1975"
		logo = "Gibson"
		desc_id = Instrument_Marauder_NATO
		desc_name = 'Instrument_Marauder_NATO'
		mesh = 'models\\Guitars\\Guitar_skin_Marauder_NATO.skin'
		pak = 'pak\\models\\guitars\\Marauder_NATO\\Marauder_NATO.pak'
		type = guitar
		guitar = marauder
		finish = "Natural"
		blurb = "Vers le milieu des années 1970, la Marauder était une guitare bon marché permettant aux musiciens de se faire la main sur une vraie Gibson.\\n\\nSa production fut stoppée au bout de cinq ans.\\n\\nInspirée à la fois de la forme sculptée de la Les Paul et de la tête de la Flying V, cette guitare est devenue aujourd'hui un instrument de collection très recherché pour sa rareté et son originalité.\\n\\nPaul Stanley, Thurston Moore et Josh Homme sont fans de la Marauder."
	}
	{
		name = "Marauder"
		name2 = "1975"
		logo = "Gibson"
		desc_id = Instrument_Marauder_Red
