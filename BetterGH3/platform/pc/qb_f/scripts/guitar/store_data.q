Bonus_Songs_Info = [
	{
		item = avalancha
		text = "Heroes del Silencio est un groupe de rock né à Saragosse en Espagne. Après s'être séparé en 1997, suite à 10 années de carrière et de nombreux albums, le groupe s'est reformé en 2007 à l'occasion du 20e anniversaire de Heroes del Silencio. Une tournée mondiale de 10 concerts est prévue, et ce, 10 ans après leur séparation."
		album_cover = HeroesDelSilencioAvalancha
	}
	{
		item = bellyofashark
		text = "The Gallows est un groupe de punk formé en 2005 à Watford en Angleterre. Ce titre est tiré de leur premier album 'Orchestra of Wolves'."
		album_cover = store_song_default
	}
	{
		item = cantbesaved
		text = "Extrait de 'Still Searching', deuxième album complet de Senses Fail. Le personnage principal de l'album parle de ses angoisses et de son combat contre l'alcool et la dépression pour retrouver la foi."
		album_cover = SensesFailStillSearching
	}
	{
		item = closer
		text = "Lacuna Coil est un groupe italien né à Milan. Ils ont d'abord été connus sous le nom de Sleep of Right, puis d'Ethereal avant de signer avec la maison de disques Century Media en 1997. Après s'être aperçus que le nom Ethereal était déjà utilisé, ils ont adopté celui de Lacuna Coil."
		album_cover = LacunaCoilKarmaCode
	}
	{
		item = dontholdback
		text = "Cette chanson est tirée du second album de The Sleeping, 'Question and Answers', avec Victory Records. The Sleeping a été formé en 2003 à partir des anciens membres de Skycamefalling."
		album_cover = TheSleepingQuestionsAndAnswers
	}
	{
		item = downndirty
		text = "S'élevant au-dessus des ombres de la Cité des anges en proie à la décadence, les L.A. Slumlords mettent le feu à Guitar Hero 3 avec un cocktail molotov de rock révolutionnaire !"
		album_cover = store_song_default
	}
	{
		item = fcpremix
		text = "Il s'agit d'une reprise de la chanson F.C.P.S.I.T.S.G. E.P.G.E.P.G.E.P., enregistrée à l'origine sur leur album éponyme."
		album_cover = FallofTroyDoppelganger
	}
	{
		item = generationrock
		text = "Revolverheld est un groupe de rock né à Hambourg en Allemagne. Cette chanson est le premier single du groupe, diffusé sur les ondes en juin 2005, 3 mois avant la sortie d'un album éponyme."
		album_cover = RevolverheldRevolverheld
	}
	{
		item = gothatfar
		text = "Bret Michaels, l'ancien chanteur de Poison, est de retour avec cette fois-ci son propre groupe. Brett est aussi responsable de l'animation des chanteurs dans le jeu."
		album_cover = BretMichealsBandGoThatFar
	}
	{
		item = hierkommtalex
		text = "Ça fait plus de 20 ans que Die Toten Hosen (littéralement 'Les Pantalons morts') vadrouillent sur la scène rock. Leur premier album était plus de la rigolade qu'autre chose, mais depuis ils se concentrent dans leurs chansons sur les problèmes sociopolitiques."
		album_cover = store_song_default
	}
	{
		item = imintheband
		text = "Extrait du sixième album des rockeurs suédois. Nicke Andersson, chanteur et guitariste, était autrefois le batteur des Entombed, l'un des premiers groupes de death metal."
		album_cover = store_song_default
	}
	{
		item = impulse
		text = "Un grand merci à Zach Kamins, compositeur de musique de films, et Andy 'THPS' Gentile, meilleur joueur de THPS, pour leur participation à l'écriture de cette chanson spécialement conçue pour Guitar Hero. "
		album_cover = endlesssporadic
	}
	{
		item = inlove
		text = "Judita Wignall, chanteuse/guitariste des Scouts of St. Sebastian a participé à la capture de mouvements de la plupart des personnages féminins de Guitar Hero et les créateurs se sont inspirés d'elle pour créer Judy Nails."
		album_cover = store_song_ScoutsStSebastian
	}
	{
		item = mauvaisgarcon
		text = "Naast s'est formé en 2004 à Joinville-le-Pont. À l'origine, le groupe ne comprenait que deux membres : Gustave (chant et guitare) et Nicholas (batterie). Clod (basse et synthé) et Laka (Guitare) les ont rejoints en 2005."
		album_cover = store_song_default
	}
	{
		item = metalheavylady
		text = "Le groupe Lions, originaire d'Austin, au Texas, s'est formé en août 2005. Influencée par le hard rock des années 60-70 et la fièvre des années 90, la musique de Lions est un mélange de riffs rétro, de sons novateurs et d'interludes mélodiques. Connu pour son attitude révolutionnaire, vous sortirez complètement sourd et désorienté de ses concerts 'furieux' et 'percutants'."
		album_cover = LionsLions
	}
	{
		item = minuscelsius
		text = "C'est à Backyard Babies que l'on doit l'apparition du sleaze rock en Suède. Originaire de Nassjo, en Suède, le groupe s'est formé en 1987, a sorti 5 albums et a même été récompensé par l'équivalent d'un Grammy."
		album_cover = store_song_default
	}
	{
		item = mycurse
		text = "Premier single de l'album 'As Daylight Dies', cette chanson a fini en 21e position des meilleures ventes rock. En 2004, Killswitch Engage a été nominé pour un Grammy dans la catégorie Meilleur groupe de metal."
		album_cover = KillswitchEngageAsDaylightDies
	}
	{
		item = nothingformehere
		text = "Le groupe Dope a été formé en 1997 par les frères Simon et Edsel Dope. Cette chanson est tirée de leur 5e album très attendu du public."
		album_cover = Dope_PosterCover_edsel
	}
	{
		item = prayeroftherefugee
		text = "Les membres de Rise Against sont tous végétariens et tentent de sensibiliser le public aux problèmes de la dégradation environnementale et de la cruauté envers les animaux."
		album_cover = store_song_default
	}
	{
		item = radiosong
		text = "Superbus est un groupe français de pop rock formé en 1999 losque la chanteuse Jennifer Ayache est rentrée des États-Unis où elle vivait et où elle a rencontré ses musiciens. Ils ont remporté en 2005 le titre de meilleur groupe français aux MTV Europe Music Awards."
		album_cover = store_song_default
	}
	{
		item = ruby
		text = "Kaiser Chiefs s'est démarqué en 2006 en remportant 3 Brit Awards : meilleur groupe, meilleur groupe de rock britannique et meilleur concert. "
		album_cover = KaiserChiefsYoursTrulyAngry_Mob
	}
	{
		item = shebangsadrum
		text = "Tiré de l'album éponyme de 1989 de The Stone Roses. Cet album est considéré comme l'un des meilleurs albums britanniques jamais sortis et a eu une influence considérable sur le mouvement Britpop des années 90."
		album_cover = StoneRosesStoneRoses
	}
	{
		item = takethislife
		text = "Créé en 1990, dans la ville de Göteborg, en Suède, In Flames est un groupe de death mélodique considéré comme l'un des fondateurs du genre. Cette chanson est extraite de l'album 'Come Clarity', entrée directement en tête des charts suédois."
		album_cover = store_song_default
	}
	{
		item = thewayitends
		text = "Prototype a été formé en 1994 à partir des anciens membres du groupe plutôt trash Psychosis. Avec ce morceau tiré de leur troisième album 'Continuum', ils font passer le metal progressive/trash au niveau supérieur."
		album_cover = prototype_continuum_cover
	}
]
Bonus_Characters_Info = [
	{
		item = axel
		text = "La tenue que choisit Axel lorsqu'il veut être à l'aise. Par exemple, lorsqu'il fait 40 degrés à l'ombre et qu'il doit jouer devant plus de 20.000 personnes pendant 4 heures lors d'un festival au Brésil."
	}
	{
		item = judy
		text = "C'est déjà la tenue que portait Judy lorsqu'elle avait 15 ans et qu'elle s'est faite renvoyer de l'école catholique."
	}
	{
		item = Lars
		text = "Lars endosse la tenue traditionnelle de ses ancêtres nordiques.  La tenue parfaite pour le rock et le pillage."
	}
	{
		item = Xavier
		text = "Regardez l'uniforme officiel que portait Xavier lorsqu'il s'est envolé à bord de sa navette spatiale pour la Nébuleuse du Crabe en 68. La classe !"
	}
	{
		item = Johnny
		text = "Lorsqu'il vivait dans la rue en 82, la veste en cuir de Johnny était son seul abri. C'était quand même cool,  il pouvait économiser de l'argent pour acheter des produits pour ses cheveux et garder sa superbe crête iroquoise."
	}
	{
		item = Midori
		text = "Midori rend hommage à l'héritage de son pays avec cette tenue inspirée du Mont Fuji.  Ouais, et elle pense aussi que les cheveux verts, c'est cool !"
	}
	{
		item = Casey
		text = "Casey essaye de montrer la part de douceur qui sommeille en elle... Comment fait-elle ? En mettant encore plus de cuir !"
	}
	{
		item = Izzy
		text = "Si vous pensiez que les autres tenues d'Izzy étaient un peu trop subtiles, le voici pomponné dans une tenue inspirée par les plus belles créatures du monde animal."
	}
	{
		item = slash
		text = "Membre de Guns N' Roses, Slash's Snakepit et Velvet Revolver, Slash s'est forgé une réputation de véritable dieu de la guitare.  Célèbre pour son style fougueux mâtiné de blues et son haut-de-forme, Slash est actuellement l'un des guitaristes les plus présents sur la scène du rock."
	}
	{
		item = morello
		text = "Au fil des années, Tom Morello a redéfini avec son jeu de guitare innovateur les capacités de cet instrument au sein de Rage Against The Machine, Audioslave et sous le nom de Nightwatchman."
	}
	{
		item = satan
		text = "Lou l'appelle 'la super sculpture que j'ai achetée sur une brocante'. On a donné vie à cette marionnette et elle sert maintenant de guitariste d'accompagnement sans cervelle ou comme videur en enfer."
	}
	{
		item = RockGod
		text = "Autrefois simple mortel, le dieu du rock a atteint le niveau de rockitude absolue et joue tous les soirs dans un pub du mont Olympe. Il trouve parfois le temps de se produire dans des duels de gratte avec des humains. C'est aussi lui qui a inventé le luth."
	}
	{
		item = RIPPER
		text = "Lorsqu'il ne parcourt pas les entrailles de l'enfer, Pierre Tombale se produit dans des tournées d'été pour mettre au point son plan d'attaque. Il aime bien aussi faire du canoë-kayak."
	}
]
