Bonus_Videos = [
	{
		id = sexpistols
		name = "The Sex Pistols"
		info = "Les Sex Pistols ont retrouvé les chemins des studios après 30 ans pour enregistrer une nouvelle version de 'Anarchy in the UK' exclusivement pour Guitar Hero 3."
		price = 1500
	}
	{
		id = brettmichaels
		name = "Bret Michaels"
		info = "Bret Michaels a prêté certains de ses mouvements perso pour le chanteur dans le jeu. Tu sauras tout sur sa visite à Neversoft où il a enfilé une combinaison de capture de mouvements pour reproduire sa présence scénique."
		price = 1500
	}
	{
		id = slash
		name = "Slash"
		info = "Suis Slash, légendaire héros de la gratte, dans les coulisses pour découvrir ce qu'il faut pour être un boss dans le jeu. Va en studio écouter Slash enregistrer un duel de guitares."
		price = 1500
	}
	{
		id = tommorello
		name = "Tom Morello"
		info = "Tom Morello, avec ses techniques de jeu innovatrices, sera le premier boss que tu devras affronter dans Guitar Hero. Va jeter un oeil dans les coulisses pour découvrir sa composition solo créée exclusivement pour le jeu."
		price = 1500
	}
]
