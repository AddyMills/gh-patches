Bonus_Songs_Info = [
	{
		item = avalancha
		text = "Héroes del Silencio es un grupo de rock originario de Zaragoza. Tras 10 años y unos cuantos discos, el grupo se separó en 1997. En el 2007, para conmemorar los 20 años de su nacimiento y los 10 años desde su disolución, realizarán una gira mundial de 10 conciertos."
		album_cover = HeroesDelSilencioAvalancha
	}
	{
		item = bellyofashark
		text = "Los Gallows son un grupo punk de Watford, Inglaterra, que se formó en 2005. Este tema bestial ha sido extraído de su primer álbum 'Orchestra of Wolves'."
		album_cover = store_song_default
	}
	{
		item = cantbesaved
		text = "Extraído del segundo álbum completo de Senses Fail, titulado 'Still Searching'. El álbum cuenta la historia de un personaje y sus tensiones y angustias, así como su lucha contra la fe, el alcohol y la depresión."
		album_cover = SensesFailStillSearching
	}
	{
		item = closer
		text = "El grupo Lacuna Coil nació en Milán (Italia), aunque se dio a conocer con otro nombre, Sleep of Right. Poco después pasaron a llamarse Ethereal y ficharon por Century Media Records en 1997. Sin embargo, este cambio no sería el definitivo, ya que pronto descubrieron que Ethereal pertenecía a otro grupo, y optaron por Lacuna Coil."
		album_cover = LacunaCoilKarmaCode
	}
	{
		item = dontholdback
		text = "Este tema es del segundo álbum de The Sleeping, titulado 'Questions and Answers', de Victory Records. The Sleeping se formó en 2003 a partir de la banda Skycamefalling."
		album_cover = TheSleepingQuestionsAndAnswers
	}
	{
		item = downndirty
		text = "Saliendo de las sombras del centro de una sucia ciudad de ángeles, ¡los L.A. Slum Lords le meten fuego al escenario con un cóctel molotov de revolución rockera!"
		album_cover = store_song_default
	}
	{
		item = fcpremix
		text = "Este tema es una nueva versión del tema F.C.P.S.I.T.S.G. E.P.G.E.P.G.E.P., que se incluyó por primera vez en su álbum homónimo."
		album_cover = FallofTroyDoppelganger
	}
	{
		item = generationrock
		text = "Revolverheld es un grupo de rock de la ciudad alemana de Hamburgo. Este tema fue su primer single y se lanzó en junio de 2005, tres meses antes de la aparición del álbum homónimo del grupo."
		album_cover = RevolverheldRevolverheld
	}
	{
		item = gothatfar
		text = "Bret Michaels, el antiguo cantante de la estridente banda de glam metal Poison está de vuelta con su nuevo grupo, creado por él mismo. Brett también se ofreció para que sus movimientos fueran captados para el cantante en el juego."
		album_cover = BretMichealsBandGoThatFar
	}
	{
		item = hierkommtalex
		text = "Die Toten Hosen (que significa literalmente 'Los pantalones muertos') están dando candela desde hace 20 años. Las canciones de su primer álbum trataban sobre todo de la diversión, pero desde entonces han evolucionado a temas más políticos y sociales."
		album_cover = store_song_default
	}
	{
		item = imintheband
		text = "Extraída del sexto álbum de los rockeros suecos. El guitarrista y vocalista principal Nicke Andersson solía tocar la batería en Entombed, los pioneros del Death Metal."
		album_cover = store_song_default
	}
	{
		item = impulse
		text = "Muchas gracias a Zach Kamins, especialista en sincronización de música e imagen, y al mejor jugador de THPS, Andy 'THPS' Gentile, por colaborar en la composición de este tema para el juego Guitar Hero."
		album_cover = endlesssporadic
	}
	{
		item = inlove
		text = "Se copiaron los movimientos de la guitarrista/vocalista de los Scouts of St. Sebastian, Judita Wignall (anterior componente del grupo The Halo Friendlies) para el personaje femenino del juego y fue la inspiración para Judy Nails."
		album_cover = store_song_ScoutsStSebastian
	}
	{
		item = mauvaisgarcon
		text = "Naast se creó en  Joinville-le-Pont en 2004. La banda se componía originalmente de tan solo dos miembros, Gustave(guitarra y cantante) y Nicolas (batería).  Los miembros Clod (bajo y teclado) y Laka (guitarra) se unieron a la banda en 2005."
		album_cover = store_song_default
	}
	{
		item = metalheavylady
		text = "Lions es un grupo de Austin, Texas que se formó en agosto de 2005. Su música tiene mucha influencia del rock duro de los 60 y 70 combinado con la fiebre de los 90. Lions crearon una mezcla de riffs retro, ruido artístico, interludios melódicos y una actitud revolucionaria en el escenario que ha sido descrita como 'furiosa' con un 'ataque frontal' que te dejará medio tonto y totalmente desorientado."
		album_cover = LionsLions
	}
	{
		item = minuscelsius
		text = "El grupo Backyard Babies es prácticamente responsable de haber llevado el rock sleaze a Suecia. Procedente de Nassjo, Suecia, el grupo, formado en 1987, ha grabado ya cinco álbumes musicales y ha ganado incluso un Grammy sueco."
		album_cover = store_song_default
	}
	{
		item = mycurse
		text = "El primer single extraído del álbum 'As Daylight Dies', se colocó en la posición número 21 de las listas de éxitos. En 2004, Killswitch Engage fue nominado para el Grammy a la Mejor actuación de metal."
		album_cover = KillswitchEngageAsDaylightDies
	}
	{
		item = nothingformehere
		text = "Dope vino en 1997 de la mano de los hermanos Simon and Edsel Dope.  Este tema es de su quinto álbum, que todo el mundo esperaba con ansiedad."
		album_cover = Dope_PosterCover_edsel
	}
	{
		item = prayeroftherefugee
		text = "Los miembros de Rise Against son todos vegetarianos o vegetarianos estrictos, y suelen poner de actualidad los problemas del medioambiente y la crueldad contra los animales."
		album_cover = store_song_default
	}
	{
		item = radiosong
		text = "Superbus son un grupo francés de pop-rock formado por cinco componentes.  Se creó en 1999 después de que la cantante Jennifer Ayache regresó a Francia después de vivir en EE.UU. para buscar más componentes. En 2005, se hicieron con el premio Mejor Artista de Francia en los premios Europeos de la música de la MTV."
		album_cover = store_song_default
	}
	{
		item = ruby
		text = "Kaiser Chiefs arrasaron en los premios Brit 2006, en los que se llevaron el premio al 'Mejor Grupo', a la 'Mejor Actuación de Rock Británica' y a la 'Mejor Actuación en Directo'."
		album_cover = KaiserChiefsYoursTrulyAngry_Mob
	}
	{
		item = shebangsadrum
		text = "Tema extraído del disco homónimo, The Stone Roses, de 1989.  El álbum es considerado por muchos como uno de los mejores álbumes británicos jamás puestos a la venta y tuvo una gran influencia en el movimiento Britpop de los 90."
		album_cover = StoneRosesStoneRoses
	}
	{
		item = takethislife
		text = "Nacido en la ciudad sueca de Gotemburgo en 1990, el grupo In Flames fue uno de los pioneros de lo que hoy se conoce como death metal melódico. Este tema es del álbum 'Come Clarity', que se aupó al número 1 de las listas suecas desde su lanzamiento."
		album_cover = store_song_default
	}
	{
		item = thewayitends
		text = "Prototype se formaron en 1994 a partir de las cenizas de la banda de thrash metal de L.A. Psychosis. Llevan el thrash metal y progresivo al siguiente nivel con este tema extraído de su tercer álbum 'Continuum'."
		album_cover = prototype_continuum_cover
	}
]
Bonus_Characters_Info = [
	{
		item = axel
		text = "Para cuando Axel necesita algo más ligerito. Como cuando tocamos en un bolo de 4 horas delante de 20.000 personas a 50 grados en un festival en Brasil."
	}
	{
		item = judy
		text = "El mismo modelito que llevaba Judy el día que la expulsaron de un colegio católico cuando tenía 15 años."
	}
	{
		item = Lars
		text = "Lars se coloca un traje tradicional originario de sus antepasados nórdicos. El traje perfecto para ciertas actividades..."
	}
	{
		item = Xavier
		text = "No te pierdas el uniforme oficial de Xavier cuando viajó en una astronave a la Nebulosa del Cangrejo en el 68. En dos palabras: im-presionante."
	}
	{
		item = Johnny
		text = "La chaqueta de cuero de Johnny fue su resguardo cuando vivía en la calle en el año 82. Gracias a eso pudo ahorrar para comprar suficientes productos para el cabello y mantener su increíble cresta."
	}
	{
		item = Midori
		text = "Midori ofrece tributo a su país natal con este atuendo inspirado en el Monte Fuji. Sí, y también se cree que el pelo verde mola."
	}
	{
		item = Casey
		text = "Cassey intenta mostrar su cara más tierna sólo como ella sabe: poniéndose más cuero."
	}
	{
		item = Izzy
		text = "Por si acaso pensabas que el otro traje de Izzy era demasiado sutil, ahora se ha engalanado con un modelito inspirado en una de las criaturas más bellas del reino animal."
	}
	{
		item = slash
		text = "Como miembro de Guns N' Roses, Slash's Snakepit y Velvet Revolver, Slash se ha ganado a pulso el título de Guitar Hero. Célebre por su estilo agresivo con tintes de blues y su incondicional sombrero de copa, Slash es uno de los guitarristas más consolidados del rock and roll hoy en día."
	}
	{
		item = morello
		text = "Tom Morello ha colaborado para sentar las bases de lo que una guitarra es capaz, gracias a su papel a través de los años en Rage Against The Machine, Audioslave y su proyecto en solitario The Nightwatchman."
	}
	{
		item = satan
		text = "Lou lo describió como 'una escultura flipante que compré en un mercadillo'. A esta marioneta se le dio vida y ahora se ha convertido en un guitarrista y en un gorila de discoteca del más allá. "
	}
	{
		item = RockGod
		text = "Mortal en el pasado, el dios del rock ha ido subiendo en el escalafón rockero y toca por las noches en un pub en el Monte Olimpo.  A veces, saca tiempo para poder enfrentarse a los mortales.  También se le atribuye la creación del laúd."
	}
	{
		item = RIPPER
		text = "Cuando no está buscando cosas en el inframundo para su próximo gran concierto, Morticio Rip hace giras terrenales en verano como parte de su modus operandi. También le gusta montar en canoa."
	}
]
