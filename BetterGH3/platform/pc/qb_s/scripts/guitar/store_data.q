Bonus_Videos = [
	{
		id = sexpistols
		name = "The Sex Pistols"
		info = "Los Sex Pistols vuelven a entrar en el estudio por primera vez desde 1977 para grabar una nueva versión de 'Anarchy in the U.K.' en exclusiva para Guitar Hero 3."
		price = 1500
	}
	{
		id = brettmichaels
		name = "Bret Michaels"
		info = "Bret Michaels cedió algunas de sus poses típicas para el cantante del juego.  Mira su visita a Neversoft donde accedió a ponerse el traje de captación de movimientos para que se captaran sus movimientos típicos."
		price = 1500
	}
	{
		id = slash
		name = "Slash"
		info = "Sigue a Slash, un guitarrista clásico, para descubrir qué hay que hacer para ser un auténtico maestro de este juego.  Ve al estudio para ver cómo Slash graba algunos duelos de guitarras."
		price = 1500
	}
	{
		id = tommorello
		name = "Tom Morello"
		info = "Tom Morello ofrece su original técnica a la hora de tocar la guitarra y será el primer experto al que vas a encontrarte en Guitar Hero.  Sigue a Tom y mira cómo compone un nuevo solo en exclusiva para el juego."
		price = 1500
	}
]
