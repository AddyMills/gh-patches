Bonus_Videos = [
	{
		id = sexpistols
		name = "The Sex Pistols"
		info = "I Sex Pistols hanno rimesso piede in uno studio di registrazione per la prima volta dopo il 1977 per incidere una nuova versione di 'Anarchy in the U.K.' esclusivamente per Guitar Hero 3."
		price = 1500
	}
	{
		id = brettmichaels
		name = "Bret Michaels"
		info = "Alcuni dei movimenti caratteristici di Bret Michaels sono stati ripresi in motion capture per il cantante del gioco.  Dai un' occhiata alla sua visita a Neversoft, dove ha indossato la tuta mo-cap per riprendere i suoi movimenti sul palco."
		price = 1500
	}
	{
		id = slash
		name = "Slash"
		info = "Vai nel backstage dove il leggendario chitarrista Slash sta scoprendo cosa serve per sfondare in questo gioco. Vai nello studio dove Slash sta buttando giù un pezzo da urlo."
		price = 1500
	}
	{
		id = tommorello
		name = "Tom Morello"
		info = "Tom Morello, con la sua innovativa tecnica e il suo stile unico, è il chitarrista più straordinario che incontrerai in Guitar Hero. Vai dietro le quinte dove Tom sta componendo il suo nuovo lavoro da solista appositamente per questo gioco."
		price = 1500
	}
]
