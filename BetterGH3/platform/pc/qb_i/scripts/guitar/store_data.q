Bonus_Songs_Info = [
	{
		item = avalancha
		text = "Gli Heroes del Silencio sono un gruppo rock di Saragozza, in Spagna. Dopo 10 anni e parecchi album, il gruppo si sciolse nel 1997. Nel 2007, per celebrare il ventennale e a 10 anni dal loro scioglimento, il gruppo sta prendendo parte a un tour mondiale di 10 date."
		album_cover = HeroesDelSilencioAvalancha
	}
	{
		item = bellyofashark
		text = "I Gallows sono una punk band di Watford, Inghilterra, nata nel 2005. Questa canzone è tratta dal loro esordio 'Orchestra of Wolves'."
		album_cover = store_song_default
	}
	{
		item = cantbesaved
		text = "Tratto dal secondo album completo dei Senses Fail: Still Searching. La storia dell'album analizza il punto di vista di un personaggio vittima di stress e ansia e le sue battaglie contro fede, alcool e depressione."
		album_cover = SensesFailStillSearching
	}
	{
		item = closer
		text = "I Lacuna Coil si sono formati a Milano, in Italia, e all'inizio si chiamavano Sleep of Right.  Nel 1997 cambiarono il nome in Ethereal e firmarono un contratto con la Century Media Records. Il nome Lacuna Coil fu scelto quando il gruppo si rese conto che il nome Ethereal era già stato utilizzato."
		album_cover = LacunaCoilKarmaCode
	}
	{
		item = dontholdback
		text = "Questo brano è estratto da Questions and Answers, il secondo album in studio degli Sleeping, prodotto dalla Victory Records. Gli Sleeping si sono formati nel 2003 dagli Skycamefalling."
		album_cover = TheSleepingQuestionsAndAnswers
	}
	{
		item = downndirty
		text = "Cresciuti nella penombra della periferia di una città di angeli decaduti, i 'L.A. Slum Lords' hanno incendiato Guitar Hero 3 con un cocktail sfavillante di rivoluzione rock!"
		album_cover = store_song_default
	}
	{
		item = fcpremix
		text = "Questo brano è un rifacimento di F.C.P.S.I.T.S.G. E.P.G.E.P.G.E.P. contenuto nell'album omonimo."
		album_cover = FallofTroyDoppelganger
	}
	{
		item = generationrock
		text = "I Revolverheld sono un gruppo rock di Amburgo, in Germania. Questo brano è stato il loro primo singolo ed è stato pubblicato nel giugno 2005, tre mesi prima dell'album dal titolo omonimo."
		album_cover = RevolverheldRevolverheld
	}
	{
		item = gothatfar
		text = "Brett Michaels, ex voce dei Poison, la famigerata band glam metal, è tornato con il suo vecchio gruppo.  Brett è anche l'autore delle performance animate del vocalist del gioco."
		album_cover = BretMichealsBandGoThatFar
	}
	{
		item = hierkommtalex
		text = "I Die Toten Hosen (letteralmente 'I pantaloni morti') sono in circolazione da oltre 20 anni. I brani del loro primo album parlavano soprattutto di divertimento, ma col tempo hanno trattato argomenti più impegnativi di carattere politico e sociale."
		album_cover = store_song_default
	}
	{
		item = imintheband
		text = "Tratto dal sesto album dei rocker svedesi. Il cantante/chitarrista principale Nicke Anderson suonava la batteria negli Entombed, pionieri del death metal."
		album_cover = store_song_default
	}
	{
		item = impulse
		text = "Congratulazioni a Zach Kamins, che lavora abitualmente su colonne sonore, e al miglior giocatore di THPS in assoluto, Andy 'THPS' Gentile, per aver collaborato a questo brano, scritto appositamente per Guitar Hero."
		album_cover = endlesssporadic
	}
	{
		item = inlove
		text = "Judita Wignall, chitarrista/vocalist degli Scouts of St. Sebastian (e ancor prima degli Halo Friendlies) si è esibita in una performance ripresa in motion capture che è stata utilizzata per molti dei personaggi femminili del gioco, ed è stata di grande ispirazione per il personaggio Judy Nails."
		album_cover = store_song_ScoutsStSebastian
	}
	{
		item = mauvaisgarcon
		text = "I Naast si sono formati a Joinville-le-Pont nel 2004. Originariamente il gruppo era composto solo da due membri, Gustave (chitarra e voce) e Nicholas (percussioni). Clod (basso, tastiere) e Laka (chitarra) sono subentrati nel 2005."
		album_cover = store_song_default
	}
	{
		item = metalheavylady
		text = "I Lions si sono formati ad Austin, in Texas nell'agosto del 2005. La loro musica è un misto di influenze hard rock anni '60 e '70 con la musica febbrile anni '90. I Lions suonano riff retrò, producono rumore artistico, amano gli interludi melodici e hanno un atteggiamento rivoluzionario. Il risultato di tutto questo sono concerti furiosi con assalti frontali che lasciano il pubblico stordito."
		album_cover = LionsLions
	}
	{
		item = minuscelsius
		text = "I Backyard Babies sono considerati da molti i pionieri del rock 'sporco' in Svezia. Originari di Nassjo, in Svezia, i Backyard Babies si sono formati nel 1987, e da allora hanno realizzato cinque album in studio e vinto un Grammy svedese."
		album_cover = store_song_default
	}
	{
		item = mycurse
		text = "Primo singolo dell'album 'As Daylight Dies', questo brano è arrivato alla posizione 21 nella classifica rock. Nel 2004 i Killswitch Engage sono stati candidati a un Grammy per la migliore performance metal."
		album_cover = KillswitchEngageAsDaylightDies
	}
	{
		item = nothingformehere
		text = "I fratelli Simon ed Edsel Dope hanno fondato il gruppo dei Dope nel 1997. Questo brano è estratto dal loro attesissimo quinto album."
		album_cover = Dope_PosterCover_edsel
	}
	{
		item = prayeroftherefugee
		text = "I membri dei Rise Against, tutti vegetariani o vegan, sono impegnati in campagne di sensibilizzazione su problemi come il degrado ambientale e la violenza sugli animali."
		album_cover = store_song_default
	}
	{
		item = radiosong
		text = "I Superbus sono un gruppo pop-rock francese composto da cinque elementi. Si sono formati nel 1999 dopo che la cantante Jennifer Ayache è tornata in patria dagli Stati Uniti e si è messa in cerca di musicisti. Nel 2005 hanno vinto il Best French Act Award agli MTV Europe Music Awards."
		album_cover = store_song_default
	}
	{
		item = ruby
		text = "I Kaiser Chiefs hanno stravinto ai Brit Awards del 2006, ottenendo i riconoscimenti come: Miglior gruppo, Miglior performance rock britannica, Miglior performance dal vivo."
		album_cover = KaiserChiefsYoursTrulyAngry_Mob
	}
	{
		item = shebangsadrum
		text = "Tratto dall'omonimo album di esordio del 1989 degli Stone Roses. L'album è considerato da molti uno dei migliori che sia mai stato realizzato in Gran Bretagna e ha apportato un notevole contributo al movimento Britpop che si sarebbe sviluppato negli anni '90."
		album_cover = StoneRosesStoneRoses
	}
	{
		item = takethislife
		text = "Nati a Goteborg, in Svezia, nel 1990, gli In Flames sono fra i pionieri di quello che ora viene definito death metal melodico. Questo brano è tratto dall'album Come Clarity, che esordì direttamente al primo posto nelle classifiche svedesi."
		album_cover = store_song_default
	}
	{
		item = thewayitends
		text = "I Prototype si sono formati nel 1994 a Los Angeles dalle ceneri del gruppo metal Psychosis.  Con questo pezzo estratto dal loro terzo album 'Continuum', portano il metal progressive/thrash a nuove vette musicali."
		album_cover = prototype_continuum_cover
	}
]
Bonus_Characters_Info = [
	{
		item = axel
		text = "Per Axel quando ha bisogno di un po' di spazio per muoversi. Come quando deve suonare per 4 ore davanti a 20.000 persone sotto un sole cocente durante un concerto in pieno giorno in Brasile."
	}
	{
		item = judy
		text = "Lo stesso esatto completino che Judy indossava quando fu sbattuta fuori dalla scuola cattolica a 15 anni."
	}
	{
		item = Lars
		text = "Lars indossa un abito tradizionale ereditato dai suoi antenati norvegesi.  L'abbigliamento perfetto per scatenarsi a suon di rock 'n' roll!"
	}
	{
		item = Xavier
		text = "L'uniforme ufficiale che indossava Xavier quando guidava una navicella spaziale verso la Nebulosa del Granchio nel '68. Spettacolare!"
	}
	{
		item = Johnny
		text = "Johnny usava il suo giubbotto di pelle come riparo quando viveva per strada nell'82. Ma che tempi! Riusciva a mettere da parte abbastanza soldi per comprarsi i prodotti per capelli necessari a tenere dritto il suo allucinante ciuffo da moicano."
	}
	{
		item = Midori
		text = "Midori rende omaggio alla tradizione del suo paese con questo abbigliamento ispirato al Monte Fuji. È anche convinta che i capelli verdi siano un tocco perfetto."
	}
	{
		item = Casey
		text = "Casey cerca di mostrare il suo lato soft nell'unico modo che sa... indossando altra pelle!"
	}
	{
		item = Izzy
		text = "Nel caso in cui pensassi che l'altro completo di Izzy fosse un po' troppo ambiguo, ecco un altro completo ispirato a una delle più belle creature del mondo animale."
	}
	{
		item = slash
		text = "Come membro dei Guns N' Roses, degli Slash's Snakepit e dei Velvet Revolver, Slash ha dimostrato di essere un vero Guitar Hero. Famoso per il suo appassionato stile blues e per il suo caratteristico cappello a cilindro, Slash è uno dei più originali chitarristi rock del momento."
	}
	{
		item = morello
		text = "Tom Morello ha contribuito a ridefinire il concetto di chitarra grazie allo stile innovativo dimostrato negli anni della sua collaborazione con i Rage Against The Machine e gli Audioslave e nell'ambito del suo progetto da solista chiamato The Nightwatchman."
	}
	{
		item = satan
		text = "Nelle parole di Lou: 'Un'incredibile scultura che ho trovato da un rigattiere.'  A questo pupazzo è stato dato il dono della vita e ora fa il chitarrista senza cervello e il buttafuori per l'oltretomba."
	}
	{
		item = RockGod
		text = "God of Rock, una volta un semplice mortale, è salito nel paradiso del rock e ora suona in un piccolo pub sul Monte Olimpo. Di tanto in tanto, però, trova ancora il tempo per sfidare i comuni mortali a ritmo di rock. Si dice inoltre che si debba a lui l'invenzione del liuto."
	}
	{
		item = RIPPER
		text = "Quando non è impegnato a perlustrare le viscere dell'Ade per firmare il prossimo patto di sangue, Morty fa tour estivi su questa terra, seguendo il suo solito modus operandi. Gli piace anche andare in canoa e viaggiare."
	}
]
