	{
		name = "Super 400"
		name2 = "CES"
		logo = "Gibson"
		desc_id = Instrument_ES400
		desc_name = 'Instrument_ES400'
		mesh = 'models\\Guitars\\Guitar_Skin_ES400.skin'
		pak = 'pak\\models\\guitars\\ES400\\ES400.pak'
		type = guitar
		guitar = CES400
		finish = "Sunburst"
		blurb = "Un lussuoso e imponente strumento creato nel 1951, con cassa armonica arcuata e concava, facile da suonare e in grado di emettere superbe sonorità.\\n\\nIl suo aspetto rimanda ai tempi d'oro del rock anni '50, la sua estrema versatilità lo rende perfetto per una grande varietà di generi, dal rock al jazz, passando per la musica country.\\n\\nIl chitarrista di Elvis, Scotty Moore, era un estimatore della Super 400.\\n\\nAnche Mark Knopfler è un suo fan, oltre naturalmente al grande Chet Atkins, che usava una Super 400-CES."
	}
