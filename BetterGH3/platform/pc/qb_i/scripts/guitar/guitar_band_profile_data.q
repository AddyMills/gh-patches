	{
		name = "SG"
		name2 = "Special Faded"
		logo = "Gibson"
		desc_id = Instrument_SG_Worn_Brown
		desc_name = 'Instrument_SG_Worn_Brown'
		mesh = 'models\\Guitars\\Guitar_Skin_SG001.skin'
		pak = 'pak\\models\\guitars\\SG_WornBrown\\SG_WornBrown.pak'
		type = guitar
		guitar = sg
		finish = "Worn Brown"
		blurb = "La SG è stata, fin dal 1961, una valida alternativa alla Les Paul per i fanatici della Gibson. \\n\\nPiù sottile e leggera della Les Paul, la SG presenta una sonorità e un'esperienza di suono molto diverse rispetto alla sua più tozza compagna di scuderia. \\n\\nOrmai assurta a nuovo classico della Gibson, la SG è disponibile in una grande varietà di stili, opzioni e rifiniture. \\n\\nFra gli amanti della SG vale la pena menzionare Jimi Hendrix, Angus Young e Pete Townshend. La SG era la chitarra scelta da Eric Clapton all'epoca dei Cream."
	}
	{
		name = "SG"
		name2 = "Special Faded"
		logo = "Gibson"
