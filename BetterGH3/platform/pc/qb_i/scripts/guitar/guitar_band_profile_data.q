		type = guitar
		guitar = special
		finish = "Special"
		blurb = "Da quei simpaticoni della Axe, un'ascia meravigliosa, perfettamente bilanciata, con una tastiera di precisione di tutto rispetto. \\n\\nVedrai che anche le tue ascelle te ne saranno riconoscenti!"
	}
	{
		name = "Distant Visitor"
