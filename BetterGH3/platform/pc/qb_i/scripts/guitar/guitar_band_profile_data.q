	{
		name = "Marauder"
		name2 = "1975"
		logo = "Gibson"
		desc_id = Instrument_Marauder_NATO
		desc_name = 'Instrument_Marauder_NATO'
		mesh = 'models\\Guitars\\Guitar_skin_Marauder_NATO.skin'
		pak = 'pak\\models\\guitars\\Marauder_NATO\\Marauder_NATO.pak'
		type = guitar
		guitar = marauder
		finish = "Natural"
		blurb = "A partire dalla metà degli anni Settanta, la Marauder fu una chitarra che permise a chi la suonava di mettere le mani su una vera Gibson. \\n\\nLa Marauder rimase in produzione solo per cinque anni. \\n\\nGrazie alla combinazione indovinata di corpo in stile Les Paul e paletta Flying V, questa chitarra ha oggi raggiunto lo status di strumento altamente desiderabile a causa della sua rarità e dell'aspetto bizzarro. \\n\\nPaul Stanley, Thurston Moore e Josh Homme sono fra i fanatici della Marauder."
	}
	{
		name = "Marauder"
