		type = guitar
		guitar = king
		finish = "Killer Queen"
		blurb = "Qualcosa che riguarda la dinamite e i raggi laser? Di cosa si tratta? \\n\\nE chi sono io per negarlo?"
	}
	{
		name = "Tiki"
		name2 = "Fury"
		logo = "Special"
