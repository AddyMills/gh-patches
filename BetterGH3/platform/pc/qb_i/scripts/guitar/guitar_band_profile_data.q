musician_instrument = [
	{
		name = "ES335"
		name2 = "Dot"
		logo = "Gibson"
		desc_id = Instrument_ES335_Red
		desc_name = 'Instrument_ES335_Red'
		mesh = 'models\\Guitars\\Guitar_Skin_ES335_Red.skin'
		pak = 'pak\\models\\guitars\\ES335_Red\\ES335_Red.pak'
		type = guitar
		guitar = es335
		finish = "Cherry"
		blurb = "L'ES335 è una chitarra elettrica con cassa armonica arcuata e concava, rimasta pressoché invariata dal lontano 1958. \\n\\nSi tratta del risultato dell'esperimento The Log di Les Paul, che intendeva produrre una chitarra elettrica amplificata. \\n\\nL'altro risultato dell'esperimento fu la Les Paul con corpo solido. \\n\\nL'ES335 è una chitarra compatta ed ergonomica, dai toni magnifici. \\n\\nFra i personaggi più famosi che l'hanno suonata figurano: Alex Lifeson dei Rush, B.B. King e Dave Grohl."
	}
	{
		name = "ES335"
		name2 = "Dot"
		logo = "Gibson"
