	{
		name = "Corvus"
		name2 = "II"
		logo = "Gibson"
		desc_id = Instrument_Corvus_NATO
		desc_name = 'Instrument_Corvus_NATO'
		mesh = 'models\\Guitars\\Guitar_skin_Corvus_NATO.skin'
		pak = 'pak\\models\\guitars\\Corvus_NATO\\Corvus_NATO.pak'
		type = guitar
		guitar = corvus
		finish = "Natural"
		blurb = "La Corvus ha rappresentato un audace tentativo della Gibson di presentare una chitarra dalla linea innovativa agli appassionati del genere. \\n\\nMolti chitarristi trovavano la sua insolita silhouette troppo audace in confronto all'enorme gamma di modelli tradizionali disponibili, o forse la Gibson stava dimostrando di precorrere i tempi, come sempre. \\n\\nQualunque sia il motivo, la Corvus non ha avuto un immediato successo commerciale, ma come la Marauder, è poi diventata un pezzo da collezione proprio grazie alla sua rarità e al suo aspetto originale. \\n\\nSe vuoi distinguerti dalla massa, questa è la chitarra per te!"
	}
