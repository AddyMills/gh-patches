	}
	{
		name = "El Jefe"
		name2 = "The Las Vegan"
		logo = "Special"
		desc_id = Instrument_Guitar_Pharaoh
		desc_name = 'Instrument_Guitar_Pharaoh'
		mesh = 'models\\Guitars\\Guitar_Skin_Pharaoh.skin'
		pak = 'pak\\models\\guitars\\Pharaoh\\Pharaoh.pak'
		type = guitar
		guitar = special
		finish = "Special"
		blurb = "Alcuni dicono che questo era lo strumento che Cleopatra diede a Cesare come suo più grande pegno d'amore. \\n\\nAltri dicono che potrebbe essere il liuto sacro del Faraone Nebkheperure Tutankhamon, figlio di Amenhotep III. \\n\\nAltri ancora, invece, immaginano che si tratti di un'antica lira d'oro offerta in dono alla regina Vittoria da Sir Samuel Baker, il famoso esploratore del XIX secolo. \\n\\nIn realtà si tratta di una chincaglieria di plastica proveniente da Las Vegas."
	}
	{
		name = "Axe"
		name2 = "Clix"
		logo = "Special"
		desc_id = Instrument_Axe
		desc_name = 'Instrument_Guitar_Axe'
