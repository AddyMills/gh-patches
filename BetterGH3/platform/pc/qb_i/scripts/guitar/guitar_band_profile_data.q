		mesh = 'models\\Guitars\\Guitar_Skin_Rojimbo.skin'
		pak = 'pak\\models\\guitars\\Rojimbo\\Rojimbo.pak'
		type = guitar
		guitar = special
		finish = "Special"
		blurb = "Se potessi avere una chitarra Samurai di plastica, saresti a posto. \\n\\nLa tastiera è in un nuovo materiale bioplastico trasparente che dà l'impressione che le corde fluttuino nel vuoto. \\n\\nNon commestibile."
	}
	{
		name = "Tiki"
		name2 = "Fortune"
		logo = "Special"
		desc_id = Instrument_Guitar_Fortune
		desc_name = 'Instrument_Guitar_Fortune'
		mesh = 'models\\Guitars\\Guitar_Fortune_Skin.skin'
		pak = 'pak\\models\\guitars\\Fortune\\Fortune.pak'
		type = guitar
		guitar = special
		finish = "Fortune"
		blurb = "Un nuovo gioiello della TIKI! Colleziona il set completo e vinci un fantastico premio! \\n\\nIl suono di questa chitarra Tiki ti farà tornare con la memoria alla bellezza dell'oceano Pacifico, alle lunghe giornate oziose passate sulla spiaggia e ai grandi amori andati della tua vita. \\n\\nQuelli sì che erano bei tempi! \\n\\nLa vita era un sogno. \\n\\nIl sole brillava alto nel cielo, i giorni sembravano non finire mai e tu avevi tutto ciò che ti serviva, e in gran quantità. \\n\\nPoi hai avuto la brillante idea di unirti a un gruppo..."
	}
	{
		name = "Card Sharp"
		name2 = "Farewell To Kings"
