	{
		name = "DMZ6000g"
		name2 = "Aluminum Neck"
		logo = "Kramer"
		desc_id = Instrument_DMZ6000G
		desc_name = 'Instrument_DMZ6000G'
		mesh = 'models\\Guitars\\Guitar_Skin_DMZ6000g.skin'
		pak = 'pak\\models\\guitars\\DMZ6000g\\DMZ6000g.pak'
		type = guitar
		guitar = dmz6000g
		finish = "Natural"
		blurb = "Le chitarre Kramer, dal manico in alluminio, erano rivoluzionarie. \\n\\nAvevano una potenza incredibile e una sonorità fuori dal comune. La Kramer produceva una grande quantità di corpi di varie forme, nei legni migliori. \\n\\nQueste chitarre andavano alla grande sul palco e avevano, inoltre, prestazioni eccellenti in studio."
	}
	{
		name = "Synapse"
		name2 = "SS-2FA Custom"
		logo = "Steinberger"
		desc_id = Instrument_synaps
		desc_name = 'Instrument_synaps'
		mesh = 'models\\Guitars\\Guitar_Skin_Synapse.skin'
		pak = 'pak\\models\\guitars\\synaps\\synaps.pak'
		type = guitar
		guitar = Synapse
		finish = "Black"
		blurb = "Ned Steinberger ha progettato la L2 negli anni '70. Tre prototipi furono venduti a John Entwistle, Tony Levin e Andy West. Costruiti in carbonio e grafite, erano privi di paletta, con le meccaniche situate sul ponte. Introdotta nel mercato negli anni '80 fu accolta con entusiasmo. Fra i predecessori della Synapse vi sono le serie L e M, progettate con Mike Rutherford. \\n\\nGrazie al suo attraente look, la Synapse è stata l'ultima evoluzione della tradizione Steinberger e offre la medesima suonabilità, forza e ricchezza tonale dei modelli che l'hanno preceduta."
	}
	{
		name = "   Les Paul   "
		name2 = "Standard"
		logo = "Epiphone"
		desc_id = Instrument_EpiPaul01
		desc_name = 'Instrument_EpiPaul01'
		mesh = 'models\\Guitars\\Guitar_Skin_EpiPaul01.skin'
		pak = 'pak\\models\\guitars\\Epiphone\\EpiPaul01.pak'
		type = guitar
		guitar = epiphone_les_paul
		finish = "Black"
		blurb = "La Epiphone è il marchio di base della Gibson. Produce repliche della Les Paul per chi desidera la linea dinamica ed ergonomica della più grande chitarra rock del mondo senza spendere troppo. \\n\\nLa Les Paul è la chitarra elettrica più conosciuta, longeva e immediatamente riconoscibile nella storia del rock. \\n\\nSi tratta di una chitarra di grande qualità che tutte le aspiranti divinità del rock sognano di possedere.\\n\\nJimmy Page, Zakk Wylde, Slash e un ristretto gruppo di veterani del rock hanno reso la Les Paul quella leggendaria Voce del rock che è oggi.\\n\\nSali sul palco con questa chitarra e ti guadagnerai di diritto il tuo posto nell'Olimpo del rock!"
	}
	{
		name = "   Les Paul   "
		name2 = "Standard"
		logo = "Epiphone"
		desc_id = Instrument_EpiPaul02
		desc_name = 'Instrument_EpiPaul02'
		mesh = 'models\\Guitars\\Guitar_Skin_EpiPaul02.skin'
		pak = 'pak\\models\\guitars\\Epiphone\\EpiPaul02.pak'
		type = guitar
		guitar = epiphone_les_paul
		finish = "Red"
		blurb = "La Epiphone è il marchio di base della Gibson. Produce repliche della Les Paul per chi desidera la linea dinamica ed ergonomica della più grande chitarra rock del mondo senza spendere troppo. \\n\\nLa Les Paul è la chitarra elettrica più conosciuta, longeva e immediatamente riconoscibile nella storia del rock. \\n\\nSi tratta di una chitarra di grande qualità che tutte le aspiranti divinità del rock sognano di possedere.\\n\\nJimmy Page, Zakk Wylde, Slash e un ristretto gruppo di veterani del rock hanno reso la Les Paul quella leggendaria Voce del rock che è oggi.\\n\\nSali sul palco con questa chitarra e ti guadagnerai di diritto il tuo posto nell'Olimpo del rock!"
	}
	{
		name = " Explorer "
		name2 = "Standard"
		logo = "Epiphone"
		desc_id = Instrument_EpiExplor01
		desc_name = 'Instrument_EpiExplor01'
		mesh = 'models\\Guitars\\Guitar_Skin_EpiExplor01.skin'
		pak = 'pak\\models\\guitars\\Epiphone\\EpiExplor01.pak'
		type = guitar
		guitar = epiphone_Explorer
		finish = "Red"
		blurb = "La Epiphone è il marchio di base della Gibson. La Epiphone produce repliche dell'Explorer per chi non vuole rinunciare al fattore meraviglia ma al contempo non può permettersi il lusso dell'originale. \\n\\nAll'inizio, nel 1958, era conosciuta come Gibson Explorer, ma fu successivamente ribattezzata Futura. Al pari della cugina, la Flying V, si trattava di un modello originale e ardito. \\n\\nAll'inizio fu un fiasco commerciale e, nel 1959, venne messa fuori produzione. \\n\\nNel 1975 la Gibson tornò a produrre la Explorer, la quale si trasformò immediatamente in un classico, a dimostrazione che alcune idee sono decisamente avanti coi tempi. \\n\\nThe Edge, James Hetfield e Dave Grohl hanno dato il loro contributo alla diffusione di questo strumento dinamico."
	}
	{
		name = " Explorer "
		name2 = "Standard"
		logo = "Epiphone"
		desc_id = Instrument_EpiExplor02
		desc_name = 'Instrument_EpiExplor02'
		mesh = 'models\\Guitars\\Guitar_Skin_EpiExplor02.skin'
		pak = 'pak\\models\\guitars\\Epiphone\\EpiExplor02.pak'
		type = guitar
		guitar = epiphone_Explorer
		finish = "Black"
		blurb = "La Epiphone è il marchio di base della Gibson. La Epiphone produce repliche dell'Explorer per chi non vuole rinunciare al fattore meraviglia ma al contempo non può permettersi il lusso dell'originale. \\n\\nAll'inizio, nel 1958, era conosciuta come Gibson Explorer, ma fu successivamente ribattezzata Futura. Al pari della cugina, la Flying V, si trattava di un modello originale e ardito. \\n\\nAll'inizio fu un fiasco commerciale e, nel 1959, venne messa fuori produzione. \\n\\nNel 1975 la Gibson tornò a produrre la Explorer, la quale si trasformò immediatamente in un classico, a dimostrazione che alcune idee sono decisamente avanti coi tempi. \\n\\nThe Edge, James Hetfield e Dave Grohl hanno dato il loro contributo alla diffusione di questo strumento dinamico."
	}
	{
		name = " SG "
		name2 = "Standard"
		logo = "Epiphone"
		desc_id = Instrument_EpiSG01
		desc_name = 'Instrument_EpiSG01'
		mesh = 'models\\Guitars\\Guitar_Skin_EpiSG01.skin'
		pak = 'pak\\models\\guitars\\Epiphone\\EpiSG01.pak'
		type = guitar
		guitar = epiphone_SG
		finish = "Red"
		blurb = "Epiphone è il marchio di base della Gibson. Epiphone produce repliche dell'SG per coloro che vogliono spendere poco senza rinunciare all'aspetto e alla suonabilità della SG originale. \\n\\nLa SG è stata, fin dal 1961, una valida alternativa alla Les Paul per i fanatici della Gibson. Più sottile e leggera della Les Paul, offre una sonorità caratteristica e garantisce una diversa esperienza di suono rispetto alla sua più tozza compagna di scuderia. \\n\\nOrmai assurta a nuovo classico della Gibson, la SG è disponibile in una grande varietà di stili, opzioni e rifiniture. \\n\\nFra gli amanti della SG vale la pena menzionare Jimi Hendrix, Angus Young e Pete Townshend. \\n\\nLa SG era la chitarra scelta da Eric Clapton all'epoca dei Cream."
	}
	{
		name = " SG "
