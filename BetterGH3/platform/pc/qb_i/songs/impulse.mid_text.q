impulse_markers_text_e5fa3adf = "Intro"
impulse_markers_text_2361e1db = "Il riff più pesante"
impulse_markers_text_0775ddd3 = "Gli accordi più dolci"
impulse_markers_text_b0662765 = "La parte più scoppiettante"
impulse_markers_text_1df867a6 = "L'assolo 'non-prog' più progressive"
impulse_markers_text_4321e94b = "Lo slide più sentimentale"
impulse_markers_text_2549a458 = "Il riff più funky della storia"
impulse_markers_text_dbd2f7fe = "Il breakdown più psicotico"
impulse_markers_text_29aa67f3 = "I doppi pedali migliori"
impulse_markers_text_3ec95080 = "L'interludio più elegante"
impulse_markers_text_f4ad3c9e = "l'assolo post-CI più straordinario"
impulse_markers_text_4cde6f9c = "Assolo incredibilmente bello"
