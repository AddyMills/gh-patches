		pak = 'pak\\models\\guitars\\Fortune\\Fortune.pak'
		type = guitar
		guitar = special
		finish = "Fortune"
		blurb = "Noch mehr TIKI-Wahnsinn - sammle das komplette Set und gewinne einen tollen Preis! \\n\\nDiese Tiki-Gitarre weckt Träume vom wunderschönen Pazifik, dem entspannten Inselleben und deiner verlassenen Liebe. \\n\\nDas waren noch Zeiten. \\n\\nDas Leben war idyllisch. \\n\\nDie Sonne schien, jeder Tag dauerte ewig und du hattest alles im Überfluss. \\n\\nAber dann musstest du dich unbedingt einer Band anschließen …"
	}
