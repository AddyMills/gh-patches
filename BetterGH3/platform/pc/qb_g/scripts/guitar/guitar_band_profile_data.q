	{
		name = "DMZ6000g"
		name2 = "Aluminum Neck"
		logo = "Kramer"
		desc_id = Instrument_DMZ6000G
		desc_name = 'Instrument_DMZ6000G'
		mesh = 'models\\Guitars\\Guitar_Skin_DMZ6000g.skin'
		pak = 'pak\\models\\guitars\\DMZ6000g\\DMZ6000g.pak'
		type = guitar
		guitar = dmz6000g
		finish = "Natural"
		blurb = "Mit ihren Hälsen aus Aluminium stellten Kramers Gitarren eine Revolution dar. \\n\\nSie waren robust wie Panzer und hatten einen Hammer-Sound. Kramer produzierte viele verschiedene Korpora aus hervorragenden Hölzern. \\n\\nAuf der Bühne sahen diese Gitarren super aus und im Studio hatten sie einen ausgezeichneten Klang."
	}
	{
		name = "Synapse"
		name2 = "SS-2FA Custom"
		logo = "Steinberger"
		desc_id = Instrument_synaps
		desc_name = 'Instrument_synaps'
		mesh = 'models\\Guitars\\Guitar_Skin_Synapse.skin'
		pak = 'pak\\models\\guitars\\synaps\\synaps.pak'
		type = guitar
		guitar = Synapse
		finish = "Black"
		blurb = "Die L2 wurde in den 70ern von Ned Steinberger entworfen. Drei Prototypen wurden an John Entwistle, Tony Levin und Andy West verkauft. \\n\\nDie Bässe wurden aus Graphit und ohne Kopfplatte gefertigt. Die Wirbel befinden sich am Steg. \\n\\nIn den frühen 80ern fanden sie reißenden Absatz. \\n\\nVorläufer der Synapse sind die L- und M-Serien, die mit Hilfe von Mike Rutherford (Genesis) entworfen wurden. \\n\\nDie kopflose, Köpfe verdrehende Synapse ist die neueste Bassgitarre der Steinberger-Tradition und verfügt über die Spielbarkeit, Stabilität und Tonalität ihrer Vorgänger."
	}
	{
		name = "   Les Paul   "
		name2 = "Standard"
		logo = "Epiphone"
		desc_id = Instrument_EpiPaul01
		desc_name = 'Instrument_EpiPaul01'
		mesh = 'models\\Guitars\\Guitar_Skin_EpiPaul01.skin'
		pak = 'pak\\models\\guitars\\Epiphone\\EpiPaul01.pak'
		type = guitar
		guitar = epiphone_les_paul
		finish = "Black"
		blurb = "Epiphone ist Gibsons Marke für Anfänger. Epiphone macht Les Paul-Kopien für Leute, die nicht viel Geld haben, aber dennoch Wert auf die Dynamik und ergonomische Form der weltbesten Rockgitarre legen. \\n\\nDie Les Paul ist die bekannteste, robusteste und am schnellsten erkennbare E-Gitarre der Rockgeschichte. \\n\\nSie ist die hochwertige Gitarre, nach der alle Möchtegern-Rocker streben. \\n\\nJimmy Page, Zakk Wylde, Slash und eine Gruppe ausgewählter Rockkoryphäen haben die Les Paul zu der Legende gemacht, die sie heute ist.\\n\\nGeh mit dieser Gitarre auf die Bühne und verdiene dir deinen rechtmäßigen Platz in der Ruhmeshalle des Rock 'n' Roll."
	}
	{
		name = "   Les Paul   "
		name2 = "Standard"
		logo = "Epiphone"
		desc_id = Instrument_EpiPaul02
		desc_name = 'Instrument_EpiPaul02'
		mesh = 'models\\Guitars\\Guitar_Skin_EpiPaul02.skin'
		pak = 'pak\\models\\guitars\\Epiphone\\EpiPaul02.pak'
		type = guitar
		guitar = epiphone_les_paul
		finish = "Red"
		blurb = "Epiphone ist Gibsons Marke für Anfänger. Epiphone macht Les Paul-Kopien für Leute, die nicht viel Geld haben, aber dennoch Wert auf die Dynamik und ergonomische Form der weltbesten Rockgitarre legen. \\n\\nDie Les Paul ist die bekannteste, robusteste und am schnellsten erkennbare E-Gitarre der Rockgeschichte. \\n\\nSie ist die hochwertige Gitarre, nach der alle Möchtegern-Rocker streben. \\n\\nJimmy Page, Zakk Wylde, Slash und eine Gruppe ausgewählter Rockkoryphäen haben die Les Paul zu der Legende gemacht, die sie heute ist.\\n\\nGeh mit dieser Gitarre auf die Bühne und verdiene dir deinen rechtmäßigen Platz in der Ruhmeshalle des Rock 'n' Roll."
	}
	{
		name = " Explorer "
		name2 = "Standard"
		logo = "Epiphone"
		desc_id = Instrument_EpiExplor01
		desc_name = 'Instrument_EpiExplor01'
		mesh = 'models\\Guitars\\Guitar_Skin_EpiExplor01.skin'
		pak = 'pak\\models\\guitars\\Epiphone\\EpiExplor01.pak'
		type = guitar
		guitar = epiphone_Explorer
		finish = "Red"
		blurb = "Epiphone ist Gibsons Marke für Anfänger. Epiphone macht Explorer-Kopien für Leute, die nicht viel Geld haben, aber dennoch den Wow-Faktor einer echten Explorer erleben möchten. \\n\\nDie 1958 unter dem Namen Gibson Explorer bekannt gewordene Gitarre wurde später in Futura umbenannt. Genau wie ihre Verwandte, die Flying V, hatte sie etwas Faszinierendes und Originelles an sich. \\n\\nAnfangs konnte sie keine kommerziellen Erfolge verbuchen und ihre Herstellung wurde 1959 eingestellt. \\n\\nDoch 1975 brachte Gibson die Explorer erneut auf den Markt und sie wurde auf der Stelle zum Klassiker. Das beweist, dass manche Ideen ihrer Zeit voraus sind. \\n\\nThe Edge, James Hetfield und Dave Grohl haben dazu beigetragen, dieses dynamische Instrument berühmt zu machen."
	}
	{
		name = " Explorer "
		name2 = "Standard"
		logo = "Epiphone"
		desc_id = Instrument_EpiExplor02
		desc_name = 'Instrument_EpiExplor02'
		mesh = 'models\\Guitars\\Guitar_Skin_EpiExplor02.skin'
		pak = 'pak\\models\\guitars\\Epiphone\\EpiExplor02.pak'
		type = guitar
		guitar = epiphone_Explorer
		finish = "Black"
		blurb = "Epiphone ist Gibsons Marke für Anfänger. Epiphone macht Explorer-Kopien für Leute, die nicht viel Geld haben, aber dennoch den Wow-Faktor einer echten Explorer erleben möchten. \\n\\nDie 1958 unter dem Namen Gibson Explorer bekannt gewordene Gitarre wurde später in Futura umbenannt. Genau wie ihre Verwandte, die Flying V, hatte sie etwas Faszinierendes und Originelles an sich. \\n\\nAnfangs konnte sie keine kommerziellen Erfolge verbuchen und ihre Herstellung wurde 1959 eingestellt. \\n\\nDoch 1975 brachte Gibson die Explorer erneut auf den Markt und sie wurde auf der Stelle zum Klassiker. Das beweist, dass manche Ideen ihrer Zeit voraus sind. \\n\\nThe Edge, James Hetfield und Dave Grohl haben dazu beigetragen, dieses dynamische Instrument berühmt zu machen."
	}
	{
		name = " SG "
		name2 = "Standard"
		logo = "Epiphone"
		desc_id = Instrument_EpiSG01
		desc_name = 'Instrument_EpiSG01'
		mesh = 'models\\Guitars\\Guitar_Skin_EpiSG01.skin'
		pak = 'pak\\models\\guitars\\Epiphone\\EpiSG01.pak'
		type = guitar
		guitar = epiphone_SG
		finish = "Red"
		blurb = "Epiphone ist Gibsons Marke für Anfänger. Epiphone macht SG-Kopien für Leute, die nicht viel Geld haben, aber dennoch Wert auf das Aussehen und das Spielerlebnis einer echten SG legen. \\n\\nSeit 1961 ist die SG unter Gibson-Fans eine beliebte Alternative zur Les Paul. Sie ist dünner und leichter als die Les Paul und unterscheidet sich dadurch akustisch und spieltechnisch von ihrer kompakteren Schwester. \\nEndlich gibt es einen weiteren Gibson-Klassiker, die SG, in vielen verschiedenen Modellen, Ausführungen und Lackierungen. \\n\\nBerühmte SG-Spieler sind Jimi Hendrix, Angus Young und Pete Townshend. Während seiner Zeit bei Cream war sie auch Eric Claptons bevorzugte Gitarre."
	}
