	{
		name = " Les Paul "
		name2 = "Standard"
		logo = "Gibson"
		desc_id = Instrument_Les_Paul
		desc_name = 'Instrument_Les_Paul'
		mesh = 'models\\Guitars\\Les_Paul_skin.skin'
		pak = 'pak\\models\\guitars\\les_paul\\les_paul.pak'
		type = guitar
		guitar = les_paul
		finish = "Sunburst"
		blurb = "Die Les Paul ist die bekannteste, robusteste und am schnellsten erkennbare E-Gitarre der Rockgeschichte. \\n\\nSie ist die hochwertige Gitarre, nach der alle Möchtegern-Rocker streben.\\n\\nJimmy Page, Zakk Wylde, Slash und eine Gruppe ausgewählter Rockkoryphäen haben die Les Paul zu der legendären Stimme des Rock gemacht, die sie heute ist.\\n\\nGeh mit dieser Gitarre auf die Bühne und verdiene dir deinen rechtmäßigen Platz in der Ruhmeshalle des Rock 'n' Roll."
	}
