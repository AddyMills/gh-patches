musician_instrument = [
	{
		name = "ES335"
		name2 = "Dot"
		logo = "Gibson"
		desc_id = Instrument_ES335_Red
		desc_name = 'Instrument_ES335_Red'
		mesh = 'models\\Guitars\\Guitar_Skin_ES335_Red.skin'
		pak = 'pak\\models\\guitars\\ES335_Red\\ES335_Red.pak'
		type = guitar
		guitar = es335
		finish = "Cherry"
		blurb = "Die ES335 ist eine Hollow Body E-Gitarre mit gewölbtem Korpus, die seit 1958 nicht groß verändert wurde. \\n\\nSie war das praktische Ergebnis von Les Pauls Versuch, eine verstärkte E-Gitarre zu bauen, aus dem auch The Log hervorging. \\n\\nDie andere Gitarre, die aus diesem Experiment hervorging war die Solidbody Les Paul.\\n\\nDie ES335 ist eine kompakte und ergonomische Gitarre mit einem wunderschönen Klang.\\n\\nBerühmte Gitarristen wie Alex Lifeson von Rush, B.B. King und Dave Grohl schwören auf sie."
	}
	{
		name = "ES335"
		name2 = "Dot"
		logo = "Gibson"
