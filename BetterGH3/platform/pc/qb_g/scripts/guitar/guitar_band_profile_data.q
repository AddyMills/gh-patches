	{
		name = "V-Factor"
		name2 = "Ebony"
		logo = "Gibson"
		desc_id = Instrument_Ebony_Vee
		desc_name = 'Instrument_Ebony_Vee'
		mesh = 'models\\Guitars\\Guitar_Skin_Vee_Black.skin'
		pak = 'pak\\models\\guitars\\Vee_Ebony\\Vee_Ebony.pak'
		type = guitar
		guitar = vee
		finish = "Ebony"
		blurb = "Es ist schwer zu glauben, dass eine Rockikone wie die V einmal etwas anderes als ein Riesenerfolg war.\\n\\nDennoch wurde die Flying V, wie sie ursprünglich hieß, als zu seltsam und ausgefallen betrachtet, um ein breites Publikum anzusprechen.\\n\\nDie Flying V wurde 1967 mit einigen kosmetischen und mechanischen Änderungen neu herausgebracht und erreichte Großes.\\n\\nZu den berühmtesten Gitarristen, die eine Flying V spielten, gehören Jimi Hendrix (er besaß eine Version mit einer eigens angefertigten psychedelischen Lackierung), K.K. Downing (Judas Priest), Dave Davis (Kinks), Kirk Hammett, Zakk Wylde, Mike McReady, Joe Perry, Michael Schenker und viele andere.\\n\\nDiese Gitarre verfügt über den Klang und die Flexibilität, die typisch für Gibson sind, sowie eine größere Bühnenpräsenz, als du je brauchen wirst."
	}
