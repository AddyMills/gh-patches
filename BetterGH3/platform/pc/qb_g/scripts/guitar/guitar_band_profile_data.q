		type = guitar
		guitar = les_paul_digital
		finish = "Blue"
		blurb = "Die Les Paul ist die geläufigste, robusteste und am schnellsten erkennbare E-Gitarre der Rockgeschichte. \\n\\nSie ist die hochwertige Gitarre, nach der alle Möchtegern-\\nRockgötter streben.\\n\\nJimmy Page, Zakk Wylde, Slash und eine Gruppe ausgewählter Rockkoryphäen haben die Les Paul zu der Legende gemacht, die sie heute ist.\\n\\nGeh mit dieser Gitarre auf die Bühne und verdiene dir deinen rechtmäßigen Platz in der Ruhmeshalle des Rock 'n' Roll! \\n\\nMit dieser modernen, digitalen Version lassen sich sämtliche Grenzen und Einschränkungen beim Gitarre spielen durchbrechen."
	}
	{
		name = "Marauder"
		name2 = "1975"
		logo = "Gibson"
		desc_id = Instrument_Marauder_NATO
		desc_name = 'Instrument_Marauder_NATO'
		mesh = 'models\\Guitars\\Guitar_skin_Marauder_NATO.skin'
		pak = 'pak\\models\\guitars\\Marauder_NATO\\Marauder_NATO.pak'
		type = guitar
		guitar = marauder
		finish = "Natural"
		blurb = "Ab Mitte der 70er Jahre war die Marauder eine Anfängergitarre, die es Spielern ermöglichte, Hand an eine echte Gibson zu legen. \\n\\nDie Marauder wurde nur fünf Jahre lang hergestellt. \\n\\nAufgrund ihrer ausgefallenen Kombination eines Korpus im Les Paul-Stil und der Kopfplatte einer Flying V ist diese Gitarre mittlerweile ein vielgesuchtes Instrument. Das hat sie größtenteils ihrer Seltenheit und ihrem ungewöhnlichen Aussehen zu verdanken. \\n\\nPaul Stanley, Thurston Moore und Josh Homme zählen zu den berühmtesten Marauder-Fans."
	}
