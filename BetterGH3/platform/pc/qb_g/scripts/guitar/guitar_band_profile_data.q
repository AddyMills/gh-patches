	{
		name = "SG"
		name2 = "Special Faded"
		logo = "Gibson"
		desc_id = Instrument_SG_Worn_Brown
		desc_name = 'Instrument_SG_Worn_Brown'
		mesh = 'models\\Guitars\\Guitar_Skin_SG001.skin'
		pak = 'pak\\models\\guitars\\SG_WornBrown\\SG_WornBrown.pak'
		type = guitar
		guitar = sg
		finish = "Worn Brown"
		blurb = "Seit 1961 ist die SG unter Gibson-Fans eine beliebte Alternative zur Les Paul. \\n\\nSie ist dünner und leichter als die Les Paul und unterscheidet sich dadurch akustisch und spieltechnisch von ihrer kompakteren Schwester. \\n\\nEndlich gibt es einen weiteren Gibson-Klassiker, die SG, in vielen verschiedenen Modellen, Ausführungen und Lackierungen. \\n\\nBerühmte SG-Spieler sind Jimi Hendrix, Angus Young und Pete Townshend. Während seiner Zeit bei Cream war sie auch Eric Claptons bevorzugte Gitarre."
	}
