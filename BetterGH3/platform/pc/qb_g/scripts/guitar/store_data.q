Bonus_Videos = [
	{
		id = sexpistols
		name = "The Sex Pistols"
		info = "Die Sex Pistols betreten erstmals seit 1977 wieder das Studio, um extra für Guitar Hero 3 eine neue Version von 'Anarchy in the U.K.' aufzunehmen. "
		price = 1500
	}
	{
		id = brettmichaels
		name = "Bret Michaels"
		info = "Bret Michaels hat für den Sänger im Spiel einige seiner charakteristischen Moves festgehalten. Wirf einen Blick auf seinen Besuch bei Neversoft, wo er im Motioncapture-Anzug seinen Bühnenstil vorstellt."
		price = 1500
	}
	{
		id = slash
		name = "Slash"
		info = "Geh hinter die Kulissen um zu sehen, wie der legendäre Gitarrenheld Slash herausfindet, was man braucht, um ein Experte in dem Spiel zu werden. Geh ins Studio, um zu sehen, wie Slash einen Track mit einem Gitarrenduell aufnimmt."
		price = 1500
	}
	{
		id = tommorello
		name = "Tom Morello"
		info = "Tom Morello führt als erster Gitarrenprofi, der dir bei Guitar Hero begegnet, seine innovativen Spieltechniken vor. Geh hinter die Kulissen, um zu sehen wie Tom extra für das Spiel neue Solostücke komponiert."
		price = 1500
	}
]
