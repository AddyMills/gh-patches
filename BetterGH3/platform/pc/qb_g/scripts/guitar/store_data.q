Bonus_Songs_Info = [
	{
		item = avalancha
		text = "Heroes del Silencio sind eine Rockband aus Saragossa in Spanien. Nach 10 Jahren und zahlreichen Alben trennte sich die Band im Jahr 1997. 2007, 10 Jahre nach ihrer Auflösung, gehen sie nochmals für 10 Konzerte auf Welttour, um ihr 20-jähriges Jubiläum zu feiern."
		album_cover = HeroesDelSilencioAvalancha
	}
	{
		item = bellyofashark
		text = "The Gallows ist eine 2005 gegründete Punkband aus Watford in England. Dieser Hammertrack ist von ihrem Debütalbum 'Orchestra of Wolves'."
		album_cover = store_song_default
	}
	{
		item = cantbesaved
		text = "Dieser Song stammt von Senses Fails zweitem Longplayer Still Searching. Dieses Album ist aus der Sicht eines stress- und angstgeplagten Charakters geschrieben. Dazu gehören auch seine Kämpfe mit seinem Glauben, Alkohol und Depressionen."
		album_cover = SensesFailStillSearching
	}
	{
		item = closer
		text = "Lacuna Coil wurden in Mailand, Italien, unter dem Namen Sleep of Right gegründet. Sie änderten ihren Namen zu Ethereal und wurden 1997 von Century Media Records unter Vertrag genommen. Als sie feststellten, dass es bereits eine Band namens Ethereal gab, änderten sie ihren Namen erneut - diesmal zu Lacuna Coil."
		album_cover = LacunaCoilKarmaCode
	}
	{
		item = dontholdback
		text = "Dieser Song stammt vom zweiten Studioalbum von The Sleeping, 'Questions and Answers', das bei Victory Records erschien. The Sleeping wurde 2003 aus den restlichen Mitgliedern von Skycamefalling gegründet."
		album_cover = TheSleepingQuestionsAndAnswers
	}
	{
		item = downndirty
		text = "Die 'L.A. Slum Lords' steigen aus den Schatten einer heruntergekommen Stadt der Engel auf und entfachen mit einem mörderischen Molotowcocktail der Rock Revolution ein wahres Feuer bei Guitar Hero 3!"
		album_cover = store_song_default
	}
	{
		item = fcpremix
		text = "Dieser Song ist ein Remake des Songs F.C.P.S.I.T.S. G.E.P.G.E.P.G.E.P., der erstmals auf ihrem selbstbetitelten Album erschien."
		album_cover = FallofTroyDoppelganger
	}
	{
		item = generationrock
		text = "Revolverheld sind eine Rockband aus Hamburg in Deutschland. Diesen Song haben sie im Juni 2005, 3 Monate vor Veröffentlichung ihres selbstbetitelten Albums, als Single herausgebracht."
		album_cover = RevolverheldRevolverheld
	}
	{
		item = gothatfar
		text = "Brett Michaels, der frühere Leadsänger der berüchtigten Glam-Rock-Band Poison, ist mit einer eigenen Band wieder da. Er war auch für die Animationen des Leadsängers im Spiel verantwortlich."
		album_cover = BretMichealsBandGoThatFar
	}
	{
		item = hierkommtalex
		text = "Die Toten Hosen gibt es schon über 20 Jahre. Die Songs auf ihrem ersten Album gingen überwiegend darum Spaß zu haben, aber seitdem hat sich ihr Schwerpunkt auf politische und soziale Themen verlagert."
		album_cover = store_song_default
	}
	{
		item = imintheband
		text = "Aus dem sechsten Album der schwedischen Rocker. Leadsänger/-gitarrist Nicke Andersson spielte früher Schlagzeug bei den Death Metal-Pionieren Entombed."
		album_cover = store_song_default
	}
	{
		item = impulse
		text = "Zollt dem Filmmusik-Studenten Zach Kamins und dem unbestritten besten THPS-Spieler, Andy 'THPS' Gentile, Respekt und Anerkennung für ihre Mitwirkung bei diesem Song, der speziell für Guitar Hero geschrieben wurde."
		album_cover = endlesssporadic
	}
	{
		item = inlove
		text = "Scouts of St. Sebastian Gitarristin und Sängerin Judita Wignall (ehemals bei The Halo Friendlies) hat sich an der Bewegungserfassung beteiligt und war Modell für viele der weiblichen Charaktere im Spiel. Sie war auch die Inspiration für Judy Nails."
		album_cover = store_song_ScoutsStSebastian
	}
	{
		item = mauvaisgarcon
		text = "Naast wurde 2004 in Joinville-le-Pont gegründet. Ursprünglich hatte die Band nur zwei Mitglieder, Gustave (Gitarre und Gesang) und Nicholas (Schlagzeug). Clod (Bassgitarre, Keyboard) und Laka (Gitarre) schlossen sich 2005 der Band an."
		album_cover = store_song_default
	}
	{
		item = metalheavylady
		text = "Lions ist eine Band aus Austin, Texas, die im August 2005 gegründet wurde und deren Musik von der Hard-Rock-Ära der 60er und 70er sowie der Stimmung der 90er beeinflusst wurde. Die Lions kreieren eine Mischung aus Retro-Riffs, kunstvollem Lärm, melodischen Intermezzi und einer revolutionären Einstellung. Dazu liefern sie eine Liveshow, die als 'stürmisch' sowie 'laut, schnell und aggressiv' gilt und dich verwirrt und halb taub zurücklässt."
		album_cover = LionsLions
	}
	{
		item = minuscelsius
		text = "Die Backyard Babies gelten als Vorreiter des Sleaze-Rocks in Schweden. Die Band aus Nässjö, Schweden, wurde 1987 gegründet, hat inzwischen 5 Studioalben veröffentlicht und einen schwedischen Grammy gewonnen."
		album_cover = store_song_default
	}
	{
		item = mycurse
		text = "Die erste Singleauskopplung des Albums 'As Daylight Dies' schlug direkt auf Platz 21 der Rockcharts ein. 2004 wurde Killswitch Engage für den Grammy in der Kategorie 'Best Metal Performance' nominiert."
		album_cover = KillswitchEngageAsDaylightDies
	}
	{
		item = nothingformehere
		text = "Dope wurde 1997 von den Brüdern Simon und Edsel Dope gegründet. Dieser Song stammt aus ihrem heiß erwarteten fünften Studioalbum."
		album_cover = Dope_PosterCover_edsel
	}
	{
		item = prayeroftherefugee
		text = "Die Mitglieder von Rise Against sind alle Vegetarier oder Veganer und wollen auf Probleme wie Umweltzerstörung und Grausamkeit gegen Tiere aufmerksam machen."
		album_cover = store_song_default
	}
	{
		item = radiosong
		text = "Superbus ist eine fünfköpfige Poprockgruppe aus Frankreich. Sie wurde 1999 gegründet, nachdem die Sängerin Jennifer Ayache in den USA nach Musikern gesucht hatte. 2005 gewann sie den Preis als 'Best French Act' bei den MTV Europe Music Awards."
		album_cover = store_song_default
	}
	{
		item = ruby
		text = "Die Kaiser Chiefs waren die erfolgreichste Band bei den Brit Awards 2006. Sie gewannen die Preise als 'Beste Band', 'Bester britischer Rock Act' und 'Bester Live Act'."
		album_cover = KaiserChiefsYoursTrulyAngry_Mob
	}
	{
		item = shebangsadrum
		text = "Vom 1989 erschienenen Debütalbum 'The Stone Roses'. Das Album wird von vielen als bestes britisches Album aller Zeiten angesehen und hat die Britpop-Bewegung der 1990er stark beeinflusst."
		album_cover = StoneRosesStoneRoses
	}
	{
		item = takethislife
		text = "1990 in Göteborg, Schweden, gegründet, gehören In Flames zu den Pionieren einer Musikrichtung, die heute als Melodic Death Metal bekannt ist. Dieser Song stammt von ihrem Album 'Come Clarity', welches auf Platz 1 in die schwedischen Charts eingestiegen ist."
		album_cover = store_song_default
	}
	{
		item = thewayitends
		text = "Prototype wurde 1994 aus den verbliebenen Mitgliedern der Thrashband Psychosis aus L.A. gegründet. Mit diesem Track aus ihrem dritten Album 'Continuum' heben sie den Progressive-/Thrash-\\nMetal auf eine neue Ebene."
		album_cover = prototype_continuum_cover
	}
]
Bonus_Characters_Info = [
	{
		item = axel
		text = "Wenn Axel mal etwas mehr Bewegungsfreiheit braucht. Zum Beispiel, wenn er bei einem ganztägigen Festival in Brasilien bei 46 Grad ein vierstündiges Set für 20.000 Leute spielen muss."
	}
	{
		item = judy
		text = "Das gleiche Outfit, das Judy trug, als sie mit 15 aus der katholischen Mädchenschule geflogen ist."
	}
	{
		item = Lars
		text = "Lars hat traditionelle Kleidung angelegt, die von seinen nordischen Vorfahren stammt. Das perfekte Outfit zum Abrocken und Plündern."
	}
	{
		item = Xavier
		text = "Sieh dir Xaviers offizielle Uniform an, die er trug, als er '68 ein Raumschiff durch den Krebsnebel steuerte. Abgefahren!"
	}
	{
		item = Johnny
		text = "Johnnys Lederjacke war der einzige Schutz, den er hatte, als er '82 auf der Straße lebte. Aber das war cool. Er konnte Geld sparen und sich genügend Haarpflegeprodukte kaufen, um seinen Wahnsinns-\\nIrokesenschnitt zu behalten."
	}
	{
		item = Midori
		text = "Mit dieser Aufmachung will Midori ihr Land ehren. Die Inspiration dafür bekam sie vom Berg Fuji. Ach ja, außerdem dachte sie, dass toupierte grüne Haare cool sind."
	}
	{
		item = Casey
		text = "Casey versucht ihre sanfte Seite auf die einzige Art zu zeigen, die sie kennt ... indem sie mehr Leder anzieht."
	}
	{
		item = Izzy
		text = "Falls du dachtest, dass Izzys anderes Outfit etwas unauffällig war, plustert er sich jetzt mit einem Ensemble auf, dass nach dem Vorbild eines der schönsten Kreaturen des Tierreichs entworfen wurde."
	}
	{
		item = slash
		text = "Als Mitglied von Guns N' Roses, Slash's Snakepit und Velvet Revolver hat sich Slash als wahrer Gitarrenheld etabliert. Slash ist bekannt für seinen feurigen, nach Blues klingenden Stil und seinen charakteristischen Zylinder und ist heute damit einer der bekanntesten Gitarristen des Rock'n'Roll."
	}
	{
		item = morello
		text = "Tom Morello hat im Laufe der Jahre mit seiner innovativen Spielweise bei Rage Against The Machine, Audioslave und seinem Soloprojekt The Nightwatchman in der Gitarrenmusik neue Wege beschritten."
	}
	{
		item = satan
		text = "Lou nennt sie 'Diese Wahnsinns-Skulptur, die ich auf einem Flohmarkt gekauft habe.' Diese Marionette wurde zum Leben erweckt und dient nun als hirnloser Rhythmusgitarrist und Türsteher der Unterwelt."
	}
	{
		item = RockGod
		text = "Der Gott des Rock war mal menschlich, bevor er in die höchste Ebene des Rock aufgestiegen ist. Er spielt nachts in einer kleinen Kneipe auf dem Olymp, wo er sich oft mit Sterblichen eine Gitarrenschlacht liefert. Angeblich erfand er die Laute."
	}
	{
		item = RIPPER
		text = "Wenn er nicht gerade die Eingeweide des Hades durchkämmt, um den nächsten großen Act zu finden, schließt der Grim Ripper weltliche Sommertourneen in seinen Modus Operandi mit ein. Er macht auch gern Ausflüge mit dem Kanu."
	}
]
