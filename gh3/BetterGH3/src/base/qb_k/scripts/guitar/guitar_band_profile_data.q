	{
		name = " Explorer "
		name2 = "Standard"
		logo = "Epiphone"
		desc_id = Instrument_EpiExplor01
		desc_name = 'Instrument_EpiExplor01'
		mesh = 'models\\Guitars\\Guitar_Skin_EpiExplor01.skin'
		pak = 'pak\\models\\guitars\\Epiphone\\EpiExplor01.pak'
		type = guitar
		guitar = epiphone_Explorer
		finish = "Red"
		blurb = "Epiphone은 깁슨사의 초급 레벨 브랜드입니다. Epiphone은 Explorer의 복제품을 제작하여 저가에 Explorer 브랜드를 자랑하고 싶어하는 사람들에게 판매하는 제품입니다. \\n\\n원래 1958년에는 Gibson Explorer로 불렸던 이 기타는 후일 Futura로 개명되었습니다. 이 기타의 사촌뻘인 Flying V처럼 창의적이고 도전적인 이름이었죠. \\n\\n첫 생산 당시 이 제품은 상업적으로 실패작이었고 1959년에는 생산이 중단되었습니다. \\n\\n1975년에 깁슨사는 Explorer를 재출시했고 이는 순식간에 명품의 반열에 올랐습니다. 이로써 아이디어가 시대를 앞서갔다는 것을 증명한 셈이 되었습니다. \\n\\n물론 엣지, 제임스 헷필드, 데이브 그롤이 이 멋진 악기를 대중화하는데 한 몫을 하기는 했지만요."
	}
	{
		name = " Explorer "
		name2 = "Standard"
		logo = "Epiphone"
		desc_id = Instrument_EpiExplor02
		desc_name = 'Instrument_EpiExplor02'
		mesh = 'models\\Guitars\\Guitar_Skin_EpiExplor02.skin'
		pak = 'pak\\models\\guitars\\Epiphone\\EpiExplor02.pak'
		type = guitar
		guitar = epiphone_Explorer
		finish = "Black"
		blurb = "Epiphone은 깁슨사의 초급 레벨 브랜드입니다. Epiphone은 Explorer의 복제품을 제작하여 저가에 Explorer 브랜드를 자랑하고 싶어하는 사람들에게 판매하는 제품입니다. \\n\\n원래 1958년에는 Gibson Explorer로 불렸던 이 기타는 후일 Futura로 개명되었습니다. 이 기타의 사촌뻘인 Flying V처럼 창의적이고 도전적인 이름이었죠. \\n\\n첫 생산 당시 이 제품은 상업적으로 실패작이었고 1959년에는 생산이 중단되었습니다. \\n\\n1975년에 깁슨사는 Explorer를 재출시했고 이는 순식간에 명품의 반열에 올랐습니다. 이로써 아이디어가 시대를 앞서갔다는 것을 증명한 셈이 되었습니다. \\n\\n물론 엣지, 제임스 헷필드, 데이브 그롤이 이 멋진 악기를 대중화하는데 한 몫을 하기는 했지만요."
	}
	{
		name = " SG "
		name2 = "Standard"
		logo = "Epiphone"
		desc_id = Instrument_EpiSG01
		desc_name = 'Instrument_EpiSG01'
		mesh = 'models\\Guitars\\Guitar_Skin_EpiSG01.skin'
		pak = 'pak\\models\\guitars\\Epiphone\\EpiSG01.pak'
		type = guitar
		guitar = epiphone_SG
		finish = "Red"
		blurb = "Epiphone은 깁슨사의 초급 레벨 브랜드입니다. Epiphone은 SG의 복제품을 제작하여 저가에 SG 브랜드를 뽐내고 싶어하는 사람들에게 판매합니다. \\n\\n1961년부터 SG는 깁슨 팬들에게 Les Paul의 대체품으로 사랑받았습니다. Les Paul보다 얇고 가벼운 SG는 더 큰 Les Paul과는 사뭇 다른 느낌의 소리와 연주 느낌을 줍니다. \\n\\n이제 깁슨사의 또 다른 명품으로 자리잡은 SG는 여러 가지의 종류와 옵션이 출시되어 있습니다. \\n\\n유명한 SG 연주자에는 지미 헨드릭스, 앵거스 영, 피트 타운센드 등이 있습니다. \\n\\n또한 SG는 에릭 클랩튼이 Cream에서 활동할 당시 사용했던 기타이기도 합니다."
	}
