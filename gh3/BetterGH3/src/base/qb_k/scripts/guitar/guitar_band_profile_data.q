		mesh = 'models\\Guitars\\Guitar_Skin_SG003.skin'
		pak = 'pak\\models\\guitars\\SG_Black\\SG_Black.pak'
		type = guitar
		guitar = sg
		finish = "Ebony"
		blurb = "1961년부터 SG는 깁슨 팬들에게 Les Paul의 대체품으로 사랑받았습니다. \\n\\nLes Paul보다 얇고 가벼운 SG는 더 큰 Les Paul과는 사뭇 다른 느낌의 소리와 연주 느낌을 줍니다. \\n\\n이제 깁슨사의 또 다른 명품으로 자리잡은 SG는 여러 가지의 종류와 옵션이 출시되어 있습니다. \\n\\n유명한 SG 연주자에는 지미 헨드릭스, 앵거스 영, 피트 타운센드 등이 있습니다. 또한 SG는 에릭 클랩튼이 Cream에서 활동할 당시 사용했던 기타이기도 합니다."
	}
	{
		name = "SG"
		name2 = "Goddess"
		logo = "Gibson"
		desc_id = Instrument_SG_Goddess_Blue
		desc_name = 'Instrument_SG_Goddess_Blue'
		mesh = 'models\\Guitars\\Guitar_Skin_SG004.skin'
		pak = 'pak\\models\\guitars\\SG_Black\\SG_Goddess_Blue.pak'
		type = guitar
		guitar = sg
		finish = "Sky Burst"
		blurb = "활기 넘치는 색으로 도색을 한 가볍고 더 강력한 SG 기타"
	}
	{
		name = "X-Plorer"
		name2 = "Standard"
		logo = "Gibson"
		desc_id = Instrument_Explorer_Black
		desc_name = 'Instrument_Explorer_Black'
		mesh = 'models\\Guitars\\Guitar_Skin_Exp_Black.skin'
		pak = 'pak\\models\\guitars\\Explorer_Black\\Explorer_Black.pak'
		type = guitar
		guitar = xplorer
		finish = "Ebony"
		blurb = "원래 1958년에는 Gibson Explorer로 불렸던 이 기타는 후일 Futura로 개명되었습니다. \\n\\n이 기타의 사촌뻘인 Flying V처럼 창의적이고 도전적인 이름이었죠. \\n\\n첫 생산 당시 이 제품은 상업적으로 실패작이었고 1959년에는 생산이 중단되었습니다. \\n\\n1975년에 깁슨사는 Explorer를 재출시했고 이는 순식간에 명품의 반열에 올랐습니다. 이로써 아이디어가 시대를 앞서갔다는 것을 증명한 셈이 되었습니다. \\n\\n물론 엣지, 제임스 헷필드, 데이브 그롤이 이 멋진 악기를 대중화하는데 한 몫을 하기는 했지만요."
	}
	{
		name = "X-Plorer"
		name2 = "Standard"
		logo = "Gibson"
		desc_id = Instrument_Explorer_Red
		desc_name = 'Instrument_Explorer_Red'
		mesh = 'models\\Guitars\\Guitar_Skin_Exp_Red.skin'
		pak = 'pak\\models\\guitars\\Explorer_Red\\Explorer_Red.pak'
		type = guitar
		guitar = xplorer
		finish = "Cherry"
		blurb = "원래 1958년에는 Gibson Explorer로 불렸던 이 기타는 후일 Futura로 개명되었습니다. \\n\\n이 기타의 사촌뻘인 Flying V처럼 창의적이고 도전적인 이름이었죠. \\n\\n첫 생산 당시 이 제품은 상업적으로 실패작이었고 1959년에는 생산이 중단되었습니다. \\n\\n1975년에 깁슨사는 Explorer를 재출시했고 이는 순식간에 명품의 반열에 올랐습니다. 이로써 아이디어가 시대를 앞서갔다는 것을 증명한 셈이 되었습니다. \\n\\n물론 엣지, 제임스 헷필드, 데이브 그롤이 이 멋진 악기를 대중화하는데 한 몫을 하기는 했지만요."
	}
