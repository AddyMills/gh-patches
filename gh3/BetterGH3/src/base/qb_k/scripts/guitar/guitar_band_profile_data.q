	{
		name = "V-Factor"
		name2 = "Ebony"
		logo = "Gibson"
		desc_id = Instrument_Ebony_Vee
		desc_name = 'Instrument_Ebony_Vee'
		mesh = 'models\\Guitars\\Guitar_Skin_Vee_Black.skin'
		pak = 'pak\\models\\guitars\\Vee_Ebony\\Vee_Ebony.pak'
		type = guitar
		guitar = vee
		finish = "Ebony"
		blurb = "V와 같은 락의 상징이 큰 성공을 거두지 못했다는 것은 믿기 힘든 일입니다.\\n\\n하지만 Flying V는 초기에 대중의 관심을 끌기에는 너무 기괴한 모습이라고 생각되었었습니다.\\n\\n결국 1967년에 Flying V는 외형과 기계적인 수정을 거치고 나서 재발매된 후에야 대단한 일들을 이뤄낼 수 있었습니다.\\n\\nFlying V를 사용했던 유명한 연주자들에는 지미 헨드릭스(사이키델릭 도장을 한 버전을 소유했습니다.), K. K.다우닝(Judas Priest), 데이브 데이비스(Kinks), 커크 해밋, 잭 와일드, 마이크 맥레디, 조 페리, 마이클 셴커 외 다수가 있습니다.\\n\\n이 기타는 깁슨사의 기타에서 기대하는 것과 무대에서 필요한 모든 음색과 유연성을 갖추고 있습니다."
	}
