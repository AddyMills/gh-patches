		blurb = "Corvus는 기타 구매자들에게 새로운 형태를 소개하려는 깁슨사의 혁신적인 시도에서 비롯되었습니다. \\n\\n이 기타의 특이한 실루엣은 기타 구매자들이 봤을 때 어쩌면 너무 과하고, 어쩌면 깁슨사가 전에 그랬던 것처럼 너무 시대를 앞서간 것처럼 보일 수도 있습니다. \\n\\n이유야 어쨌건 이 기타는 출시 당시에는 상업적인 성공을 거두지 못했지만 Marauder와 같이 현재는 희소성과 특이한 외형으로 인해 수집가들의 수집품으로 인기를 끌고 있습니다. \\n\\n뭔가 색다른 것을 원한다면 이 기타가 제격입니다."
	}
	{
		name = "Super 400"
		name2 = "CES"
		logo = "Gibson"
		desc_id = Instrument_ES400
		desc_name = 'Instrument_ES400'
		mesh = 'models\\Guitars\\Guitar_Skin_ES400.skin'
		pak = 'pak\\models\\guitars\\ES400\\ES400.pak'
		type = guitar
		guitar = CES400
		finish = "Sunburst"
		blurb = "이것은 1951년까지 그 기원을 거슬러 올라갈 수 있는 큰 바디, 아치 모양 상판, 속이 비어있는 바디를 가진 놀라운 음색과 연주 느낌을 자랑하는 기타입니다. \\n\\n락, 재즈, 컨트리 음악에 어울리는 융통성과 풍부한 음색을 가지고 있으며 외관은 고전적인 1950년대 로큰롤 시대의 외형을 가지고 있습니다. \\n\\n이 아름다운 기타 중 하나를 가지고 있으면 마치 그 때 당시로 돌아간 것만 같은 느낌을 받을 수 있습니다. \\n\\n엘비스의 기타 주자였던 스카티 무어는 Super 400 애호가였고 마크 노플러는 팬이었으며 위대한 체트 앳킨스는 Super 400-CES를 연주했었습니다."
	}
