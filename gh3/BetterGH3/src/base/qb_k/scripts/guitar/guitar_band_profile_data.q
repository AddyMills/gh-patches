	{
		name = "ES335"
		name2 = "Dot"
		logo = "Gibson"
		desc_id = Instrument_ES335_Sunburst
		desc_name = 'Instrument_ES335_Sunburst'
		mesh = 'models\\Guitars\\Guitar_Skin_ES335_SBURST.skin'
		pak = 'pak\\models\\guitars\\ES335_SBURST\\ES335_SBURST.pak'
		type = guitar
		guitar = es335
		finish = "Vintage Sunburst"
		blurb = "ES335는 1985년 이후로 거의 변함이 없이 아치 모양 상판과 속이 빈 바디를 가진 전자 기타입니다. \\n\\n이 제품은 앰프 전자 기타를 제작하려던 Log, Les Paul의 다양한 시도들에서 얻어진 실용적인 결과들을 모아서 제작된 기타입니다. \\n\\n이 실험으로 인해 탄생한 다른 기타는 속이 꽉찬 바디를 가진 Les Paul입니다. \\n\\n ES335는 작고 인체공학적이며 환상적인 음색을 자랑하는 기타입니다. \\n\\n유명한 연주자로는 Rush의 알렉스 라이프슨, B.B. 킹, 데이브 그롤이 있습니다."
