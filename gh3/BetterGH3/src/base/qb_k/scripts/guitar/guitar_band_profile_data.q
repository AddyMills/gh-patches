		pak = 'pak\\models\\guitars\\les_paul\\les_paul.pak'
		type = guitar
		guitar = les_paul
		finish = "Sunburst"
		blurb = "Les Paul은 가장 친숙하고 내구성이 좋으며 락의 역사 속에서 누구나 쉽게 찾아볼 수 있는 전자 기타입니다. \\n\\n어떤 사람이라도 락의 신의 경지에 오를 꿈을 품을 수 있게 만들어줄 만큼 품질이 뛰어난 기타입니다.\\n\\n지미 페이지, 잭 와일드, 슬래시, 많은 락 밴드들에 의해 Les Paul은 오늘날 전설이라고 불리울 만한 위치에 올랐습니다.\\n\\n이 기타를 가지고 무대에 올라 락의 왕족에게 합당한 위치를 차지하십시오! "
	}
