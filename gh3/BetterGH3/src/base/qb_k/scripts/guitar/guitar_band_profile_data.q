	{
		name = "Synapse"
		name2 = "SS-2FA Custom"
		logo = "Steinberger"
		desc_id = Instrument_synaps
		desc_name = 'Instrument_synaps'
		mesh = 'models\\Guitars\\Guitar_Skin_Synapse.skin'
		pak = 'pak\\models\\guitars\\synaps\\synaps.pak'
		type = guitar
		guitar = Synapse
		finish = "Black"
		blurb = "네드 슈타인베르거는 70년대에 L2를 설계했습니다. 세 개의 시제품은 각각 존 엔트위슬, 토니 레빈, 앤디 웨스트에게 판매되었죠. 이 제품들은 탄소와 흑연 화합물로 제작되었고 헤드가 없이 튜너가 브릿지에 달려있는 형태를 취하고 있습니다. 80년대 초에 시중에 판매되기 시작했을 때에는 매우 열광적인 반응을 이끌어 냈습니다. 이 Synapse의 조상뻘에는 L 시리즈와 M 시리즈가 포함되어 있습니다.(마이크 루더포드의 도움을 받아 설계됨) \\n\\n헤드가 없는 독특한 외형을 가진 Synapse는 슈타인베르거의 전통과 활용성, 이전 제품들의 내구성과 음색을 갖춘 최신 제품입니다."
	}
	{
		name = "   Les Paul   "
		name2 = "Standard"
		logo = "Epiphone"
		desc_id = Instrument_EpiPaul01
		desc_name = 'Instrument_EpiPaul01'
		mesh = 'models\\Guitars\\Guitar_Skin_EpiPaul01.skin'
		pak = 'pak\\models\\guitars\\Epiphone\\EpiPaul01.pak'
		type = guitar
		guitar = epiphone_les_paul
		finish = "Black"
		blurb = "Epiphone은 깁슨사의 초급 레벨 브랜드입니다. Epiphone은 Les Paul의 복제품을 제작하여 저가에 Les Paul 브랜드를 뽐내고 싶어하는 사람들에게 판매합니다. \\n\\nLes Paul은 락 역사상 가장 유명하고 오래되었으며 알아보기 쉬운 전자 기타입니다. \\n\\n이 고급 기타는 모든 락계에서 신의 경지에 오르고 싶어하는 모든 자들에게 선망의 대상이 되고 있습니다. \\n\\n지미 페이지, 잭 와일드, 슬래시와 여러 유명한 락 밴드들이 Les Paul을 지금과 같은 전설적인 기타로 만들어 놓았습니다. \\n\\n이 기타와 함께 무대에 오른다면 락계의 신전에 오를 수 있을 것입니다."
	}
	{
		name = "   Les Paul   "
		name2 = "Standard"
		logo = "Epiphone"
		desc_id = Instrument_EpiPaul02
		desc_name = 'Instrument_EpiPaul02'
		mesh = 'models\\Guitars\\Guitar_Skin_EpiPaul02.skin'
		pak = 'pak\\models\\guitars\\Epiphone\\EpiPaul02.pak'
		type = guitar
		guitar = epiphone_les_paul
		finish = "Red"
		blurb = "Epiphone은 깁슨사의 초급 레벨 브랜드입니다. Epiphone은 Les Paul의 복제품을 제작하여 저가에 Les Paul 브랜드를 뽐내고 싶어하는 사람들에게 판매합니다. \\n\\nLes Paul은 락 역사상 가장 유명하고 오래되었으며 알아보기 쉬운 전자 기타입니다. \\n\\n이 고급 기타는 모든 락계에서 신의 경지에 오르고 싶어하는 모든 자들에게 선망의 대상이 되고 있습니다. \\n\\n지미 페이지, 잭 와일드, 슬래시와 여러 유명한 락 밴드들이 Les Paul을 지금과 같은 전설적인 기타로 만들어 놓았습니다. \\n\\n이 기타와 함께 무대에 오른다면 락계의 신전에 오를 수 있을 것입니다."
