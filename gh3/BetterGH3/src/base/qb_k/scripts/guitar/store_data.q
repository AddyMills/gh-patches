		id = Guitarist_Xavier_Outfit2_Style4
		price = 250
		profile_name = 'Xavier'
		info_name = XAVIER
	}
]
Bonus_Songs_Info = [
	{
		item = avalancha
		text = "Heroes del Silencio는 스페인의 사라고사에서 시작된 락 밴드입니다. 10년간 수많은 앨범을 출시한 그들은 1997년 해체되었습니다. 밴드 결성 20주년이자 해체 10주년인 2007년에 그들은 10 콘서트 월드 투어에 참가하고 있습니다."
		album_cover = HeroesDelSilencioAvalancha
	}
	{
		item = bellyofashark
		text = "Gallows는 2005년에 결성한 웟포드의 펑크 밴드입니다. 이 킬러 트랙은 그들의 데뷔 앨범인 'Orchestra Wolves'에 수록 된 곡입니다."
		album_cover = store_song_default
	}
	{
		item = cantbesaved
		text = "Senses Fail의 두 번째 앨범 Still Searching에 실린 곡입니다. 이 앨범의 내용은 믿음과 알콜, 우울증 등과 싸우는 한 사람의 스트레스와 근심 등을 중심으로 하고 있습니다."
		album_cover = SensesFailStillSearching
	}
	{
		item = closer
		text = "Lacuna Coil은 이탈리아 밀란에서 본래 Sleep of Right라는 이름으로 결성되었습니다. 그들은 1997년 Century Media 레코드사와 계약하면서 Ethereal로 개명했고 Ethereal이라는 이름의 밴드가 이미 있다는 사실을 안 후에는 Lacuna Coil로 다시 개명했습니다."
		album_cover = LacunaCoilKarmaCode
	}
	{
		item = dontholdback
		text = "이 노래는 빅토리아 레코드에서 출시한 The Sleeping의 2번째 스튜디오 앨범, 'Questions and Answers'에 실린 곡입니다. The Sleeping은 2003년에 Skycamefalling의 전 멤버들로부터 시작되었습니다."
		album_cover = TheSleepingQuestionsAndAnswers
	}
	{
		item = downndirty
		text = "갱과 폭동의 도시 L.A.에서 시작된 'L.A. Slum Lords'는 Guitar Hero 3에서 불 같은 락의 혁명을 보여줍니다!"
		album_cover = store_song_default
	}
	{
		item = fcpremix
		text = "이 노래는 그들의 첫 앨범에 실린 'F.C.P.S.I.T.S.G. E.P.G.E.P.G.E.P' 의 리메이크입니다."
		album_cover = FallofTroyDoppelganger
	}
	{
		item = generationrock
		text = "Revolverheld는 독일 함부르크에서 시작된 락 밴드입니다. 이 노래는 2005년 6월에 출시된 그들의 첫 번째 싱글이며, 3개월 후에는 그들의 밴드명과 동일한 첫 번째 앨범이 출시되었습니다."
		album_cover = RevolverheldRevolverheld
	}
	{
		item = gothatfar
		text = "유명한 글램 메탈 밴드인 Poison의 전 리드 싱어였던 브렛 마이클스는 자신만의 밴드와 함께 돌아왔습니다. 브렛은 또한 게임 내에서 리드 보컬리스트의 애니메이션 연기를 맡았습니다."
		album_cover = BretMichealsBandGoThatFar
	}
	{
		item = hierkommtalex
		text = "Die Toten Hosen('죽은 바지들'이라 번역 되는)은 20년이 넘은 그룹입니다. 그들의 첫 앨범에 수록된 노래들은 대부분 즐거움에 대한 것이었지만 그들의 관심이 정치와 사회 문제로 옮겨지면서 바뀌었습니다."
		album_cover = store_song_default
	}
	{
		item = imintheband
		text = "이 노래는 Swedish rockers의 여섯 번째 앨범에서 발췌되었습니다. 리드 보컬/기타리스트 닉 앤더슨은 한 때 데스 메탈 아티스트들을 위해 드럼을 연주하기도 했습니다."
		album_cover = store_song_default
	}
	{
		item = impulse
		text = "영화 음악 작곡가인 자크 카민스와 최고의 THPS 플레이어인 앤디 'THPS' 젠타일에게 Guitar Hero의 게임 음악을 작곡해준 것에 대한 감사를 전합니다."
		album_cover = endlesssporadic
	}
	{
		item = inlove
		text = "Scouts of St. Sebastian의 기타리스트/보컬리스트인 주디타 위그놀(이전에 Halo Friendles 소속이었던)은 게임의 많은 여성 캐릭터를 위한 모션 캡쳐를 했고 주디 네일즈의 모체가 되었습니다."
		album_cover = store_song_ScoutsStSebastian
	}
	{
		item = mauvaisgarcon
		text = "Naast는 2004년에 조인빌 르 퐁트에서 결성되었습니다. 이 밴드는 원래 구스타프(기타와 보컬)와 니콜라스(드럼) 두명으로만 이루어져 있었습니다. 멤버인 클로드(베이스 기타, 키보드)와 라카(기타)는 2005년에 들어왔습니다."
		album_cover = store_song_default
	}
	{
		item = metalheavylady
		text = "Lions는 2005년 8월에 텍사스 오스틴에서 결성된 밴드입니다. 그들의 음악은 60년대와 70년대 하드 락의 영향을 받았습니다. Lions는 레트로 리프와 예술적인 잡음, 선율의 곡과 파격적인 공연 태도를 조합해 자신들만의 '귀를 멀게 만드는' 음악을 창조했고 Lions의 라이브 공연에는 '격렬'이나 '매우 공격적'이라는 수식어가 붙게되었습니다."
		album_cover = LionsLions
	}
	{
		item = minuscelsius
		text = "Backyard Babies는 스웨덴에 슬리즈 락을 들여오는 데 큰 공헌을 했습니다. 스웨덴의 네셰에서 활동을 시작한 이 밴드는 1987년에 시작되어 5 개의 스튜디오 앨범을 제작했고, 스웨덴의 그래미 상을 받기도 했습니다."
		album_cover = store_song_default
	}
	{
		item = mycurse
		text = "첫 번째 싱글 오프 앨범인 'As Daylight Dies'에서 이 노래는 메인스트림 락 차트에서 21위를 차지했습니다. 2004년에 Killswitch Engage는 그래미에서 최우수 메탈 공연상에 노미네이트되었습니다."
		album_cover = KillswitchEngageAsDaylightDies
	}
	{
		item = nothingformehere
		text = "Dope는 1997년, 사이먼과 에드셀 도프 형제로부터 시작되었습니다. 이 노래는 그들의 다섯 번째 스튜디오 앨범에 실렸던 곡입니다."
		album_cover = Dope_PosterCover_edsel
	}
	{
		item = prayeroftherefugee
		text = "Rise Against의 멤버들은 모두 채식주의자 혹은 완전 채식주의자입니다. 그리고 그들은 환경과 동물 학대 같은 알려진 문제를 다룹니다."
		album_cover = store_song_default
	}
	{
		item = radiosong
		text = "Superbus는 5인조 프렌치 팝 락 그룹입니다. 이들은 1999년에 싱어인 제니퍼 아야크가 미국에서 살다가 프랑스로 돌아와 뮤지션들을 찾으면서 결성되었습니다. 2005년에 이들은 MTV Europe Music Awards의 Best French Act를 수상했습니다."
		album_cover = store_song_default
	}
	{
		item = ruby
		text = "Kaiser Chiefs는 2006년 영국에서 '최고의 그룹', '영국 최고의 락 쇼', '최고의 라이브 쇼' 상을 받았습니다."
		album_cover = KaiserChiefsYoursTrulyAngry_Mob
	}
	{
		item = shebangsadrum
		text = "Stone Roses의 1989년 셀프 타이틀 앨범에 수록된 곡입니다. 이 앨범은 이제까지 영국에서 발매 되었던 뛰어난 앨범중 하나라고 여겨지며 1990년대의 영국 팝에 많은 영향을 끼쳤습니다."
		album_cover = StoneRosesStoneRoses
	}
	{
		item = takethislife
		text = "스웨덴 고텐부르그에서 1990년 시작된 In Flames 는 멜로딕 데스 메탈의 창시자 중 하나입니다. 이 노래는 스웨덴 차트에서 1위를 차지하기도 했던 그들의 앨범 'Come Clarity' 에 실린 곡입니다."
		album_cover = store_song_default
	}
	{
		item = thewayitends
		text = "Prototype은 L.A. 스래쉬 밴드인 Psychosis에 남은 사람들이 1994년에 결성하였습니다. 그들은 그들의 세번째 앨범인 'Continuum'에서 프로그레시브/스래쉬 메탈을 한 단계 진보시켰습니다."
		album_cover = prototype_continuum_cover
	}
]
Bonus_Characters_Info = [
	{
		item = axel
		text = "브라질의 한 페스티벌에서 115도의 날씨에, 4시간동안 2만명의 사람들 앞에서 연주했던 때처럼, 액슬이 약간의 기동성을 필요로 할 때 좋을 것입니다."
	}
	{
		item = JUDY
		text = "주디가 15살 때 카톨릭 고등학교에서 퇴학당할 당시 그녀가 입고 있었던 바로 그 의상입니다."
	}
	{
		item = LARS
		text = "라스는 그의 노르웨이 조상들이 입었던 것과 같은 전통적인 의상을 입습니다. 그가 지향하는 락에 완벽히 어울리는 의상입니다."
	}
	{
		item = XAVIER
		text = "68년도, 재비어가 우주선을 타고 게 성운을 통과할 때 입었던 의상입니다."
	}
	{
		item = JOHNNY
		text = "조니의 가죽 점퍼는 그가 82년도에 길거리에서 생활할 때 그의 유일한 옷이었지만, 여전히 멋있습니다. 이제 그는 멋진 헤어스타일을 관리할 용품들을 구입할 수 있을 만한 돈을 모았습니다."
	}
	{
		item = MIDORI
		text = "미도리는 그녀의 고향인 일본의 전통적인 의상을 입습니다. 아, 그리고 그녀는 초록색 염색도 멋있다고 생각했습니다."
	}
	{
		item = CASEY
		text = "케이시에게 그녀의 여성적인 면을 보여주는 방법은 단 한 가지뿐입니다… 더 많은 가죽 의상을 착용하는 것이죠."
	}
	{
		item = Izzy
		text = "이지의 다른 의상이 너무 신비적이었다고 생각하는 사람들을 위해 그는 동물 왕국에서 가장 아름다운 생물에게 영감을 받아 만들어진 의상을 입었습니다."
	}
	{
		item = slash
		text = "Guns N' Roses, Slash's Snakepit, Velvet Revolver 등에서 멤버로 활약한 슬래시는 진정한 기타 영웅으로 입지를 확고하게 다진 인물입니다. 중산모를 쓰고 열정적인 연주를 보여주는 슬래시는 이 시대 로큰롤계의 최고의 기타리스트 중 한 명입니다."
	}
	{
		item = morello
		text = "톰 모렐로는 자신의 창조적인 연주 스타일로 기타계의 새로운 장을 열었습니다. 톰은 Rage Against The Machine, Audioslave, 솔로 프로젝트인 The Nightwatchman 등에서 활약했습니다."
	}
	{
		item = SATAN
		text = "라우가 '창고 세일에서 찾은 진짜 멋있는 조각품'이라고 표현하는 이 꼭두각시 인형은 이제 지하 세계의 무의식적인 리듬 기타리스트입니다."
	}
	{
		item = RockGod
		text = "한 때는 인간이었던 락의 신은 락계에서 신의 경지에 올라섰고, 매일 밤마다 올림푸스 산의 한 술집에서 연주를 합니다. 그리고 때로는 약해빠진 인간들과 기타 배틀을 벌이기도 하며, 류트의 발명자이기도 합니다."
	}
	{
		item = RIPPER
		text = "그림 리퍼는 언제나 계약할 건수를 찾고 있거나 종종 여름 투어를 다니기도 합니다. 그리고 카누 여행도 좋아합니다."
	}
]
