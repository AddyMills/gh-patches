Bonus_Videos = [
	{
		id = sexpistols
		name = "The Sex Pistols"
		info = "Sex Pistols가 1977년 이후 처음으로 스튜디오에 들어온 이유는 Guitar Hero 3를 위한 새 버전의 'Anarchy in the U.K.'의 녹음을 하기 위해서였습니다.."
		price = 1500
	}
	{
		id = brettmichaels
		name = "Bret Michaels"
		info = "브렛 마이클스는 게임 속의 가수를 위해 그의 몇몇 독특한 행동의 모션 캡쳐를 했습니다. 네버소프트를 방문해 모캡 복장을 입고 모션 캡쳐를 한 그의 무대를 확인 해 보십시오."
		price = 1500
	}
	{
		id = slash
		name = "Slash"
		info = "전설의 기타 히어로 슬래쉬가 게임의 보스가 되기 위해선 무엇을 해야 하는지를 찾는 과정을 지켜보십시오. 스튜디오에 들어가 슬래쉬가 듀얼링 기타 곡을 치는 것을 보십시오."
		price = 1500
	}
	{
		id = tommorello
		name = "Tom Morello"
		info = "Guitar Hero에서 처음으로 마주치는 보스는 톰 모렐로의 혁신적인 연주 기법을 가져왔습니다. 톰은 게임을 위해 새로운 솔로 작품을 작곡 했습니다."
		price = 1500
	}
]
