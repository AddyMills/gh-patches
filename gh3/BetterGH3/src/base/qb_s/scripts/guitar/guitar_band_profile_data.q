musician_instrument = [
	{
		name = "ES335"
		name2 = "Dot"
		logo = "Gibson"
		desc_id = Instrument_ES335_Red
		desc_name = 'Instrument_ES335_Red'
		mesh = 'models\\Guitars\\Guitar_Skin_ES335_Red.skin'
		pak = 'pak\\models\\guitars\\ES335_Red\\ES335_Red.pak'
		type = guitar
		guitar = es335
		finish = "Cherry"
		blurb = "La ES335 es una guitarra eléctrica de cuerpo arqueado y hueco que prácticamente no ha cambiado desde 1958. \\n\\nEs el resultado práctico del experimento que fue The Log, el intento de Les Paul de crear una guitarra eléctrica amplificada. \\n\\nSin embargo, del experimento también salió otra pieza: la guitarra de cuerpo sólido Les Paul. \\n\\nLa ES335 es una guitarra compacta y ergonómica con un tono espectacular. \\n\\nAlgunos de los guitarristas famosos que no han podido resistirse a sus encantos son Alex Lifeson de Rush, B.B. King y Dave Grohl."
	}
	{
		name = "ES335"
		name2 = "Dot"
		logo = "Gibson"
