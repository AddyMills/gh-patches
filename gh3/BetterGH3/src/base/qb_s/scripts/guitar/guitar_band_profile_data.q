	{
		name = "SG"
		name2 = "Special Faded"
		logo = "Gibson"
		desc_id = Instrument_SG_Worn_Brown
		desc_name = 'Instrument_SG_Worn_Brown'
		mesh = 'models\\Guitars\\Guitar_Skin_SG001.skin'
		pak = 'pak\\models\\guitars\\SG_WornBrown\\SG_WornBrown.pak'
		type = guitar
		guitar = sg
		finish = "Worn Brown"
		blurb = "Desde 1961, la SG se ha revelado como la alternativa favorita a la Les Paul entre los partidarios de Gibson. \\n\\nMás delgada y ligera que la Les Paul, marca diferencias con su compañera más reforzada, sobre todo en lo que a sonido y sensaciones se refiere. \\n\\nAhora convertida en otro clásico de Gibson, la SG presenta un amplio abanico de estilos, opciones y acabados. \\n\\nEntre los músicos de renombre que han confiado en la SG encontramos a Jimi Hendrix, Angus Young y Pete Townshend. Además, también fue la elegida por Eric Clapton durante su etapa en el grupo Cream."
	}
	{
		name = "SG"
		name2 = "Special Faded"
		logo = "Gibson"
