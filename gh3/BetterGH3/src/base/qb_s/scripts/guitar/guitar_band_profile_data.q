	{
		name = " Explorer "
		name2 = "Standard"
		logo = "Epiphone"
		desc_id = Instrument_EpiExplor01
		desc_name = 'Instrument_EpiExplor01'
		mesh = 'models\\Guitars\\Guitar_Skin_EpiExplor01.skin'
		pak = 'pak\\models\\guitars\\Epiphone\\EpiExplor01.pak'
		type = guitar
		guitar = epiphone_Explorer
		finish = "Red"
		blurb = "Epiphone es la marca de Gibson para principiantes. Se trata de una réplica de las Explorer para los aficionados con un presupuesto ajustado que quieren gozar de las sensaciones de una auténtica Explorer. \\n\\nAunque en sus primeros tiempos, allá por 1958, se la conocía como la Gibson Explorer, más tarde pasó a llamarse Futura. Al igual que su prima, la Flying V, era un prodigio de originalidad y ruptura. \\n\\nSin embargo, no tuvo mucha suerte al salir al mercado y dejó de fabricarse en 1959. \\n\\nEn 1975, Gibson la relanzó y automáticamente se convirtió en un clásico, una prueba innegable de que algunas ideas van un paso por delante de su época. \\n\\nThe Edge, James Hetfield y Dave Grohl contribuyeron a popularizar este potente instrumento."
	}
	{
		name = " Explorer "
		name2 = "Standard"
		logo = "Epiphone"
		desc_id = Instrument_EpiExplor02
		desc_name = 'Instrument_EpiExplor02'
		mesh = 'models\\Guitars\\Guitar_Skin_EpiExplor02.skin'
		pak = 'pak\\models\\guitars\\Epiphone\\EpiExplor02.pak'
		type = guitar
		guitar = epiphone_Explorer
		finish = "Black"
		blurb = "Epiphone es la marca de Gibson para principiantes. Se trata de una réplica de las Explorer para los aficionados con un presupuesto ajustado que quieren gozar de las sensaciones de una auténtica Explorer. \\n\\nAunque en sus primeros tiempos, allá por 1958, se la conocía como la Gibson Explorer, más tarde pasó a llamarse Futura. Al igual que su prima, la Flying V, era un prodigio de originalidad y ruptura. \\n\\nSin embargo, no tuvo mucha suerte al salir al mercado y dejó de fabricarse en 1959. \\n\\nEn 1975, Gibson la relanzó y automáticamente se convirtió en un clásico, una prueba innegable de que algunas ideas van un paso por delante de su época. \\n\\nThe Edge, James Hetfield y Dave Grohl contribuyeron a popularizar este potente instrumento."
	}
	{
		name = " SG "
		name2 = "Standard"
		logo = "Epiphone"
		desc_id = Instrument_EpiSG01
		desc_name = 'Instrument_EpiSG01'
		mesh = 'models\\Guitars\\Guitar_Skin_EpiSG01.skin'
		pak = 'pak\\models\\guitars\\Epiphone\\EpiSG01.pak'
		type = guitar
		guitar = epiphone_SG
		finish = "Red"
		blurb = "Epiphone es la marca de Gibson para principiantes. Se trata de una réplica de las SG para los aficionados con un presupuesto ajustado que ha heredado las virtudes de la SG original: tiene un aspecto rompedor y es muy fácil de tocar. \\n\\nDesde 1961, la SG se ha revelado como la alternativa favorita a la Les Paul entre los partidarios de Gibson. \\n\\nMás delgada y ligera que la Les Paul, marca diferencias con su compañera más reforzada, sobre todo en lo que a sonido y sensaciones se refiere. \\n\\nAhora convertida en otro clásico de Gibson, la SG presenta un amplio abanico de estilos, opciones y acabados. \\n\\nEntre los músicos de renombre que han confiado en la SG encontramos a Jimi Hendrix, Angus Young y Pete Townshend. Además, también fue la elegida por Eric Clapton durante su etapa en el grupo Cream."
	}
