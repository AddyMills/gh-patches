	{
		name = "Marauder"
		name2 = "1975"
		logo = "Gibson"
		desc_id = Instrument_Marauder_NATO
		desc_name = 'Instrument_Marauder_NATO'
		mesh = 'models\\Guitars\\Guitar_skin_Marauder_NATO.skin'
		pak = 'pak\\models\\guitars\\Marauder_NATO\\Marauder_NATO.pak'
		type = guitar
		guitar = marauder
		finish = "Natural"
		blurb = "Desde mediados de los setenta, la Marauder, una guitarra pensada para principiantes, permitió a muchos guitarristas noveles hacerse con una auténtica Gibson. \\n\\nSin embargo, este modelo se fabricó solo durante cinco años. \\n\\nCon la curiosa combinación de un cuerpo esculpido propio de las Les Paul y un cabezal inspirado en la Flying V, la Marauder se ha convertido en un preciado instrumento, sobre todo por su rareza y su insólito aspecto. \\n\\nPaul Stanley, Thurston Moore y Josh Homme son algunos de los incondicionales de las Marauder."
	}
