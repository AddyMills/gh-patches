		name2 = "II"
		logo = "Gibson"
		desc_id = Instrument_Corvus_WHT
		desc_name = 'Instrument_Corvus_WHT'
		mesh = 'models\\Guitars\\Guitar_skin_Corvus_WHT.skin'
		pak = 'pak\\models\\guitars\\Corvus_WHT\\Corvus_WHT.pak'
		type = guitar
		guitar = corvus
		finish = "White"
		blurb = "La Corvus fue el innovador intento de Gibson para introducir una nueva forma de guitarra en el mercado. \\n\\nSu inédita silueta puede que fuera muy radical para los interesados en guitarras, dado el gran abanico de posibilidades que tenían. O simplemente es que Gibson ya era por aquella época, un adelantado de su tiempo. \\n\\nEl caso es que la guitarra no tuvo mucho éxito por aquella época, pero al igual que la Gibson Marauder, hoy se ha convertido en objeto de coleccionista debido a su estilo poco convencional. \\n\\nSi quieres saber qué se siente al ser diferente, esta es tu guitarra."
	}
	{
