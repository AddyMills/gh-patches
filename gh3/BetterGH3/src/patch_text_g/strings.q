loading_tip_1 = "Gibt es Probleme? ... Wirf einen Blick auf die Tutorials im Trainings-Menü."
loading_tip_2 = "Durchstöbere den Laden nach neuen Songs, coolen Outfits und Styles."
loading_tip_3 = "Willst du mit einem Freund abrocken? Gründet eine neue Band in der Koop-Karriere."
loading_tip_4 = "Der Übungsmodus kann dir beim Bewältigen dieser schwierigen Solos helfen."
loading_tip_5 = "Wenn ihr noch nie auf einem Vierspurrekorder aufgenommen habt, seid ihr keine richtige Band."
loading_tip_6 = "Überzeuge dich vor dem Stagediven davon, dass die Zuschauer auch bereit sind, dich aufzufangen."
loading_tip_7 = "Der Gebrauch von selbstgemachten Feuerwerkskörpern ist UNTERSAGT."
loading_tip_8 = "30 Minuten zu spät zur Probe zu kommen gehört dazu."
loading_tip_9 = "Ist es vielleicht möglich, dass die Monitore etwas weniger abkacken?"
loading_tip_10 = "Glaubt ja nicht, dass ihr die erste Band seid, die auf der Bühne nur schwarz trägt."
loading_tip_11 = "Ja, die Bühnenmonitore sind wirklich zum Crowdsurfen da."
loading_tip_12 = "Lass den Sänger niemals ans Mischpult."
loading_tip_13 = "Es geht immer noch lauter."
loading_tip_14 = "Wir sind zwar eine echt wütende Band, aber das heißt nicht, dass wir nicht an Frieden glauben."
loading_tip_15 = "20-minütige, ausschweifende Jazz-Improvisationen sind nicht OK."
loading_tip_16 = "Niemand will Geld dafür bezahlen, dich improvisieren zu hören."
loading_tip_17 = "Auszusehen, als sei man gerade erst aufgewacht, ist viel Arbeit."
loading_tip_18 = "Achte darauf, dass irgendwer in der Band weiß, wie man Reifen wechselt."
loading_tip_19 = "Dreh den Verstärker auf. Meine Ohren bluten ja kaum."
loading_tip_20 = "Früher bin ich immer ausgeflippt, wenn mein Verstärker Feuer fing, aber heute mag ich den Klang irgendwie."
loading_tip_21 = "Gitarren klingen zerschlagen einfach besser als intakt."
loading_tip_22 = "Du bist nur so gut wie dein letzter Auftritt ... und der war grottig."
loading_tip_23 = "Du hast großartig gespielt. Ich bin mir sicher, sie haben euch nur wegen euren Outfits ausgepfiffen."
loading_tip_24 = "Vielleicht taucht ja rechtzeitig zur Probe noch ein Drumcomputer auf."
loading_tip_25 = "Du scheinst ein Problem mit deinem Bass-Verstärker zu haben. Ich kann es hören!"
loading_tip_26 = "Geh da raus, rock ordentlich ab und verkaufe einen Haufen T-Shirts, damit wir was zu essen haben."
loading_tip_27 = "Beginnen wir doch mit unserer letzten Single.  Auf diese Weise räumen wir dieses Stück *&?#@! zeitig aus dem Weg!"
loading_tip_28 = "Ich bin der Schlagzeuger.  Ich werde nicht bezahlt, um etwas davon zu verstehen!"
loading_tip_29 = "Ich schwöre es, Wachtmeister, der Fernseher in der Umkleidekabine hat sich selbst von der Wand gelöst und aus dem Fenster gestürzt!"
loading_tip_30 = "Wird dir das alleine Spielen langsam langweilig? Dann geh online und miss dich an LIVE-Gegnern!"
loading_tip_31 = "Brauchst du neue Songs? Schau im Online-Menü nach, ob neue Inhalte zur Verfügung stehen!"
loading_tip_32 = "Du willst im Koop-Modus spielen, hast aber keinen Freund? Spiel online, um Leute kennenzulernen und abzujammen!"
